{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-claude",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--backend",
        "claude-code"
      ],
      "port": 5173
    },
    {
      "name": "client-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "packages/client",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "modder",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--",
        "tsx",
        "watch",
        "packages/modder/src/cli.ts",
        "serve"
      ],
      "port": 8787
    },
    {
      "name": "modder-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "modder",
        "--",
        "serve",
        "8787",
        "--script",
        "packages/modder/fixtures/offline.json",
        "--data",
        "var/offline"
      ],
      "port": 8787
    }
  ]
}
