{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client-only",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 5173
    },
    {
      "name": "dev-claude",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--backend",
        "claude-code"
      ],
      "port": 5173
    },
    {
      "name": "player",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "play"
      ],
      "port": 5174
    },
    {
      "name": "client-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "games/openworld/client",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "modder",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--",
        "tsx",
        "watch",
        "packages/modder/src/cli.ts",
        "--game",
        "games/openworld/content/src/game.ts",
        "serve"
      ],
      "port": 8787
    },
    {
      "name": "modder-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "modder",
        "--",
        "serve",
        "8787",
        "--script",
        "packages/modder/fixtures/offline.json",
        "--data",
        "var/offline"
      ],
      "port": 8787
    },
    {
      "name": "wiki",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "wiki"
      ],
      "port": 5180
    },
    {
      "name": "study",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "games/openworld/tools/src/eval/study.ts",
        "serve",
        "var/eval/study/results",
        "--port",
        "5191"
      ],
      "port": 5191
    }
  ]
}
