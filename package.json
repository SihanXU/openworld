{
  "name": "large-symbolic-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/tools/src/dev.ts",
    "dev:client": "npm run dev -w @lsw/client",
    "build": "npm run gen:world && npm run build -w @lsw/client",
    "gen:world": "tsx packages/tools/src/demo/world.ts",
    "check:world": "tsx packages/tools/src/demo/check.ts",
    "assets": "tsx packages/tools/src/copyAssets.ts",
    "coverage": "tsx packages/tools/src/coverage.ts",
    "modder": "tsx packages/modder/src/cli.ts",
    "agent": "tsx packages/agent/src/cli.ts",
    "curriculum": "tsx packages/tools/src/curriculum.ts",
    "improve": "tsx packages/tools/src/improve.ts",
    "engine-task": "tsx packages/tools/src/engine-tasks.ts",
    "latency": "tsx packages/tools/src/latency.ts",
    "curriculum:report": "tsx packages/tools/src/curriculum-report.ts",
    "ford-live": "tsx packages/tools/src/ford-live.ts",
    "eval:objects": "tsx packages/tools/src/eval-objects.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine && tsc -p packages/content && tsc -p packages/tools && tsc -p packages/agent && tsc -p packages/modder && tsc -p packages/client && tsc -p packages/wiki",
    "check": "npm run typecheck && npm test",
    "wiki": "tsx packages/wiki/src/serve.ts",
    "wiki:build": "tsx packages/wiki/src/build.ts",
    "wiki:check": "tsx packages/wiki/src/build.ts --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
