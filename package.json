{
  "name": "large-symbolic-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lsw/client",
    "build": "npm run gen:world && npm run build -w @lsw/client",
    "gen:world": "tsx packages/tools/src/genWorld.ts",
    "coverage": "tsx packages/tools/src/coverage.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine && tsc -p packages/content && tsc -p packages/tools && tsc -p packages/client",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
