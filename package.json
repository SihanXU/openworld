{
  "name": "large-symbolic-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*/*"
  ],
  "scripts": {
    "dev": "tsx games/openworld/tools/src/dev.ts",
    "dev:client": "npm run dev -w @openworld-game/client",
    "editor": "vite --config packages/editor/vite.config.ts --configLoader runner",
    "editor:build": "tsx packages/editor/scripts/build.ts",
    "editor:start": "node packages/editor/dist/server/cli.js --open",
    "desktop": "npm run editor:build && npm install --no-audit --no-fund --prefix packages/editor/desktop && npm start --prefix packages/editor/desktop",
    "desktop:dist": "npm run editor:build && npm install --no-audit --no-fund --prefix packages/editor/desktop && npm run dist --prefix packages/editor/desktop",
    "play": "vite --config packages/runtime/vite.config.ts --configLoader runner",
    "build:player": "vite build --config packages/runtime/vite.config.ts --configLoader runner && tsx packages/format/src/cli.ts build games/starter --out packages/runtime/dist/games/starter",
    "game": "tsx packages/format/src/cli.ts",
    "bake": "tsx games/openworld/client/scripts/bake.ts",
    "build": "npm run gen:world && npm run build -w @openworld-game/client",
    "continent": "tsx games/openworld/tools/src/demo/continent/main.ts",
    "scale": "tsx games/openworld/tools/src/demo/scale.ts",
    "gen:world": "tsx games/openworld/tools/src/demo/world.ts && tsx games/openworld/client/scripts/bundle.ts",
    "check:world": "tsx games/openworld/tools/src/demo/check.ts",
    "assets": "tsx games/openworld/tools/src/copyAssets.ts",
    "loudness": "tsx games/openworld/tools/src/audio/loudness.ts",
    "art:faces": "tsx games/openworld/tools/src/art/faces.ts",
    "coverage": "tsx games/openworld/tools/src/coverage.ts",
    "schema": "tsx packages/format/src/schema.ts",
    "modder": "tsx packages/ai/scripts/modder.ts --game games/openworld/content/src/game.ts",
    "agent": "tsx packages/ai/scripts/agent.ts",
    "curriculum": "tsx games/openworld/ai/src/curriculum.ts",
    "improve": "tsx games/openworld/ai/src/improve.ts",
    "engine-task": "tsx games/openworld/ai/src/engine-tasks.ts",
    "upstream": "tsx games/openworld/ai/src/upstream.ts",
    "ladder": "tsx games/openworld/ai/src/ladder.ts",
    "rsi": "tsx games/openworld/ai/src/rsi.ts",
    "latency": "tsx games/openworld/ai/src/latency.ts",
    "curriculum:report": "tsx games/openworld/ai/src/curriculum-report.ts",
    "ford-live": "tsx games/openworld/ai/src/ford-live.ts",
    "probes": "tsx games/openworld/ai/src/probes.ts",
    "eval:objects": "tsx games/openworld/ai/src/eval-objects.ts",
    "eval:affordance": "tsx games/openworld/ai/src/eval-affordance.ts",
    "test": "vitest run",
    "typecheck": "npm run typecheck:game --silent && tsc -p packages/ai && tsc -p games/openworld/ai",
    "typecheck:game": "tsc -p packages/engine && tsc -p packages/engine/test && tsc -p packages/stdlib && tsc -p packages/format && tsc -p games/starter && tsc -p packages/modules && tsc -p packages/runtime && tsc -p packages/editor && tsc -p games/openworld/content && tsc -p games/openworld/client && tsc -p games/openworld/tools && tsc -p games/openworld/wiki",
    "check": "npm run typecheck && npm test",
    "wiki": "tsx games/openworld/wiki/src/serve.ts",
    "wiki:build": "tsx games/openworld/wiki/src/build.ts",
    "wiki:check": "tsx games/openworld/wiki/src/build.ts --check",
    "wiki:translate": "tsx games/openworld/wiki/src/translate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
