[
  {
    "id": "glade/axe",
    "doc": "An axe used on something strikes it with a cutting edge (on oneself it is what the world says).",
    "host": { "tags": ["tool:axe"] },
    "on": "act/use",
    "tree": {
      "if": { "same": ["actor", "target"] },
      "then": "inherit",
      "else": {
        "do": [
          {
            "op": "emit",
            "impulse": "strike",
            "to": "target",
            "params": { "power": { "param": "power" }, "edge": "cut" }
          }
        ],
        "label": "Chop {target}"
      }
    }
  },
  {
    "id": "glade/fell",
    "doc": "A tree broken falls: a stump that grows back in a few days, and two logs.",
    "host": { "type": "tile/tree" },
    "on": "threshold/cross",
    "tree": {
      "if": { "param": { "key": "name", "cmp": "broken" } },
      "then": {
        "do": [
          { "op": "transform", "into": "tile/stump" },
          { "op": "spawn", "type": "item/material/log", "at": "host", "count": 2 },
          { "op": "vfx", "fx": "leaves" },
          { "op": "log", "text": "Timber!" }
        ]
      },
      "else": "inherit"
    }
  },
  {
    "id": "glade/bed",
    "label": "Sleep in {target}",
    "doc": "A bed taken hold of: one lies down and sleeps until it is time to rise; it is one's home.",
    "host": { "type": "fixture/furniture/bed" },
    "on": "impulse/handle",
    "tree": {
      "do": [
        { "op": "log", "text": "You lie down." },
        {
          "op": "emit",
          "impulse": "notify",
          "to": "actor",
          "params": { "what": "home", "value": { "idOf": "host" } }
        },
        { "op": "emit", "impulse": "restore", "to": "actor", "params": { "which": "sleep" } }
      ]
    }
  },
  {
    "id": "glade/talk",
    "label": "Talk to {target}",
    "doc": "A villager spoken to (a hand on them): the quests hear it, and they say what they have — a favour under way, else a line for the moment.",
    "host": { "type": "actor/person/villager" },
    "on": "impulse/handle",
    "tree": {
      "if": { "same": ["host", "actor"] },
      "then": "inherit",
      "else": { "do": [{ "op": "news", "kind": "talk" }, { "op": "quest" }] }
    }
  }
]
