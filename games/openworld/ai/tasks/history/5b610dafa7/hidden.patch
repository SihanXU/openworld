+    const ring = eng.author(() => w.create('item/valuable/ring', { on: 'tile', map: MAP, x: 5, y: 5 }, { props: { 'sub:stealth': 1, 'sub:perception': 2, 'sub:atk': 1 } }))
+    eng.author(() => w.setFact(STATS_LAYOUT, false))
+    eng.author(() => migrateStats(g))
