+    const steps = economySteps({ ...onto, types: { ...onto.types, [GEODE]: geode } } as Ontology, [], 1)
+    const b = steps.find((s) => s.name === `break ${GEODE}`)!
+    expect(b.gives.get(STONE)).toBeCloseTo(1.5, 12)
+    expect(b.gives.get(GEODE)).toBeCloseTo(0.2, 12)
+  })
