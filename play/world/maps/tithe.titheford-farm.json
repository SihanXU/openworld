3,"to":18,"map":"tithe.titheford-farm","x":26,"y":10,"activity":"work"},{"from":18,"to":21,"map":"tithe.titheford-farm","x":6,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.titheford-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk0"}},{"id":"tithe.titheford-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk0"}},{"id":"tithe.titheford-farm.folk1","type":"actor/person/farmer","name":{"en":"Joan Barleyford","zh":"琼·麦渡"},"place":{"on":"tile","map":"tithe.titheford-farm.farmhouse-1","x":1,"y":2},"facing":"down","props":{"age":37,"household":"tithe.titheford-farm.h0","purse":4,"favourite":"item/food/cheese"},"contents":["tithe.titheford-farm.folk1.coin0","tithe.titheford-farm.folk1.coin1","tithe.titheford-farm.folk1.coin2","tithe.titheford-farm.folk1.coin3"],"look":{"body":"woman","parts":{"hair":"hair.ponytail","face":"face.soft","hat":"hat.kerchief","outfit":"outfit.workdress","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"porcelain","hair":"auburn","eyes":"hazel","hat.1":"linen","outfit.1":"russet","outfit.2":"linen","legs.1":"slate","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"tithe.titheford-farm.farmhouse-1","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.titheford-farm","x":1,"y":9,"activity":"work"},{"from":12,"to":13,"map":"tithe.titheford-farm.farmhouse-1","x":5,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.titheford-farm","x":1,"y":9,"activity":"work"},{"from":18,"to":22,"map":"tithe.titheford-farm.farmhouse-1","x":5,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.titheford-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk1"}},{"id":"tithe.titheford-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk1"}},{"id":"tithe.titheford-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk1"}},{"id":"tithe.titheford-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk1"}},{"id":"tithe.titheford-farm.folk2","type":"actor/person/child","name":{"en":"Adam Barleyford","zh":"亚当·麦渡"},"place":{"on":"tile","map":"tithe.titheford-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":10,"household":"tithe.titheford-farm.h0","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["tithe.titheford-farm.folk2.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","shoes":"shoes.shoes"},"colors":{"skin":"brown","hair":"honey","eyes":"sky","outfit.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"tithe.titheford-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.titheford-farm","x":5,"y":12,"activity":"play"},{"from":12,"to":13,"map":"tithe.titheford-farm.farmhouse-1","x":7,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.titheford-farm","x":5,"y":12,"activity":"play"},{"from":18,"to":20,"map":"tithe.titheford-farm.farmhouse-1","x":7,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.titheford-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.titheford-farm.folk2"}}]}