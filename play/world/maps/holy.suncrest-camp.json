,{"from":6,"to":12,"map":"holy.suncrest-camp","x":20,"y":20,"activity":"work"},{"from":12,"to":13,"map":"holy.suncrest-camp.tent-2","x":5,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.suncrest-camp","x":20,"y":20,"activity":"work"},{"from":18,"to":21,"map":"holy.suncrest-camp","x":6,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.suncrest-camp.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk3"}},{"id":"holy.suncrest-camp.folk3.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk3"}},{"id":"holy.suncrest-camp.folk4","type":"actor/person/bard","name":{"en":"Livia Halowright","zh":"莉薇娅·环匠"},"place":{"on":"tile","map":"holy.suncrest-camp.tent-3","x":1,"y":1},"facing":"down","props":{"age":25,"household":"holy.suncrest-camp.h2","purse":2,"favourite":"item/misc/bell"},"contents":["holy.suncrest-camp.folk4.coin0","holy.suncrest-camp.folk4.coin1"],"look":{"body":"woman","parts":{"hair":"hair.long","face":"face.soft","outfit":"outfit.travel","legs":"legs.stockings"},"colors":{"skin":"fair","hair":"black","eyes":"hazel","outfit.1":"mustard","legs.1":"charcoal"}},"npc":{"role":"bard","schedule":[{"from":21,"to":7,"map":"holy.suncrest-camp.tent-3","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.suncrest-camp","x":17,"y":9,"activity":"work"},{"from":12,"to":13,"map":"holy.suncrest-camp.tent-3","x":4,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.suncrest-camp","x":17,"y":9,"activity":"work"},{"from":18,"to":21,"map":"holy.suncrest-camp","x":18,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Care for a song? One coin each. I've just learned a pilgrims' song from people on the road. It has seventeen verses.","zh":"想听首歌吗？一枚钱一首。我刚跟路上的朝圣者学了一首歌，一共十七段。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.suncrest-camp.folk4.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk4"}},{"id":"holy.suncrest-camp.folk4.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk4"}},{"id":"holy.suncrest-camp.folk5","type":"actor/person/traveler","name":{"en":"Celestine Lambbrook","zh":"塞莱斯廷·羔溪"},"place":{"on":"tile","map":"holy.suncrest-camp","x":11,"y":6},"facing":"down","props":{"age":24,"household":"holy.suncrest-camp.h3","purse":6,"favourite":"item/material/gold_ingot"},"contents":["holy.suncrest-camp.folk5.coin0","holy.suncrest-camp.folk5.coin1","holy.suncrest-camp.folk5.coin2","holy.suncrest-camp.folk5.coin3","holy.suncrest-camp.folk5.coin4","holy.suncrest-camp.folk5.coin5"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.keen","outfit":"outfit.travel"},"colors":{"skin":"light","hair":"umber","eyes":"storm","outfit.1":"madder"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":6,"map":"holy.suncrest-camp.tent-4","x":1,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"holy.suncrest-camp","x":11,"y":6,"activity":"work"},{"from":12,"to":13,"map":"holy.suncrest-camp.tent-4","x":5,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.suncrest-camp","x":11,"y":6,"activity":"work"},{"from":18,"to":21,"map":"holy.suncrest-camp","x":12,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.suncrest-camp.folk5.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}},{"id":"holy.suncrest-camp.folk5.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}},{"id":"holy.suncrest-camp.folk5.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}},{"id":"holy.suncrest-camp.folk5.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}},{"id":"holy.suncrest-camp.folk5.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}},{"id":"holy.suncrest-camp.folk5.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.suncrest-camp.folk5"}}]}