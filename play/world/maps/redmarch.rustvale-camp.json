ale-camp.tent-4","x":5,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustvale-camp.folk5.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustvale-camp.folk5"}},{"id":"redmarch.rustvale-camp.folk5.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustvale-camp.folk5"}},{"id":"redmarch.rustvale-camp.folk5.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustvale-camp.folk5"}},{"id":"redmarch.rustvale-camp.folk5.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustvale-camp.folk5"}},{"id":"redmarch.rustvale-camp.folk5.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustvale-camp.folk5"}}]}