"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.tithewick-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk0.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk0.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk0"}},{"id":"tithe.tithewick-farm.folk1","type":"actor/person/farmer","name":{"en":"Martin Copperstone","zh":"马丁·铜石"},"place":{"on":"tile","map":"tithe.tithewick-farm.farmhouse-1","x":1,"y":2},"facing":"down","props":{"age":46,"household":"tithe.tithewick-farm.h0","purse":4,"favourite":"item/food/honey"},"contents":["tithe.tithewick-farm.folk1.coin0","tithe.tithewick-farm.folk1.coin1","tithe.tithewick-farm.folk1.coin2","tithe.tithewick-farm.folk1.coin3"],"look":{"body":"man","parts":{"hair":"hair.braid","face":"face.weary","hat":"hat.straw","outfit":"outfit.workshirt","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"steelgrey","eyes":"storm","hat.1":"linen","outfit.1":"undyed","outfit.2":"moss","legs.1":"linen","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":7,"map":"tithe.tithewick-farm.farmhouse-1","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.tithewick-farm","x":23,"y":5,"activity":"work"},{"from":12,"to":13,"map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.tithewick-farm","x":23,"y":5,"activity":"work"},{"from":18,"to":21,"map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.tithewick-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk1"}},{"id":"tithe.tithewick-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk1"}},{"id":"tithe.tithewick-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk1"}},{"id":"tithe.tithewick-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk1"}},{"id":"tithe.tithewick-farm.folk2","type":"actor/person/farmer","name":{"en":"Nan Copperstone","zh":"南·铜石"},"place":{"on":"tile","map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":1},"facing":"down","props":{"age":39,"household":"tithe.tithewick-farm.h0","purse":6,"favourite":"item/food/bread"},"contents":["tithe.tithewick-farm.folk2.coin0","tithe.tithewick-farm.folk2.coin1","tithe.tithewick-farm.folk2.coin2","tithe.tithewick-farm.folk2.coin3","tithe.tithewick-farm.folk2.coin4","tithe.tithewick-farm.folk2.coin5"],"look":{"body":"woman","parts":{"hair":"hair.wavy","face":"face.bright","glasses":"glasses.round","outfit":"outfit.workdress","shoes":"shoes.buckled"},"colors":{"skin":"light","hair":"gold","eyes":"amber","glasses.1":"bronze","outfit.1":"undyed","outfit.2":"ivory","shoes.1":"black"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.tithewick-farm","x":19,"y":8,"activity":"work"},{"from":12,"to":13,"map":"tithe.tithewick-farm.farmhouse-1","x":5,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.tithewick-farm","x":19,"y":8,"activity":"work"},{"from":18,"to":22,"map":"tithe.tithewick-farm.farmhouse-1","x":5,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.tithewick-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk2.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk2.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk2"}},{"id":"tithe.tithewick-farm.folk3","type":"actor/person/child","name":{"en":"Giles Copperstone","zh":"贾尔斯·铜石"},"place":{"on":"tile","map":"tithe.tithewick-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":7,"household":"tithe.tithewick-farm.h0","purse":1,"favourite":"item/misc/doll"},"tags":["minor"],"contents":["tithe.tithewick-farm.folk3.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","shoes":"shoes.boots"},"colors":{"skin":"fair","hair":"black","eyes":"bark","outfit.1":"rose","shoes.1":"umber"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"tithe.tithewick-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.tithewick-farm.farmhouse-1","x":6,"y":1,"activity":"play"},{"from":12,"to":13,"map":"tithe.tithewick-farm.farmhouse-1","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.tithewick-farm.farmhouse-1","x":6,"y":1,"activity":"play"},{"from":18,"to":20,"map":"tithe.tithewick-farm.farmhouse-1","x":5,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.tithewick-farm.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk3"}},{"id":"tithe.tithewick-farm.folk4","type":"actor/person/child","name":{"en":"Ivo Copperstone","zh":"伊沃·铜石"},"place":{"on":"tile","map":"tithe.tithewick-farm.farmhouse-1","x":3,"y":1},"facing":"down","props":{"age":12,"household":"tithe.tithewick-farm.h0","purse":1,"favourite":"item/misc/flute"},"tags":["minor"],"contents":["tithe.tithewick-farm.folk4.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock"},"colors":{"skin":"deep","hair":"auburn","eyes":"bark","outfit.1":"ochre"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"tithe.tithewick-farm.farmhouse-1","x":3,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.tithewick-farm","x":6,"y":8,"activity":"play"},{"from":12,"to":13,"map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.tithewick-farm","x":6,"y":8,"activity":"play"},{"from":18,"to":20,"map":"tithe.tithewick-farm.farmhouse-1","x":2,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.tithewick-farm.folk4.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.tithewick-farm.folk4"}}]}