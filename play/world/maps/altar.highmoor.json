,"favourite":"item/material/frostcap"},"contents":["altar.highmoor.folk8.coin0","altar.highmoor.folk8.coin1"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","outfit":"outfit.tunic","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"black","eyes":"storm","outfit.1":"forest","shoes.1":"umber"}},"npc":{"role":"villager","schedule":[{"from":22,"to":5,"map":"altar.highmoor.home-4","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"altar.highmoor","x":36,"y":28,"activity":"work"},{"from":12,"to":13,"map":"altar.highmoor.home-4","x":7,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.highmoor","x":36,"y":28,"activity":"work"},{"from":18,"to":22,"map":"altar.highmoor","x":7,"y":28,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.highmoor.folk8.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.highmoor.folk8"}},{"id":"altar.highmoor.folk8.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.highmoor.folk8"}},{"id":"altar.highmoor.folk9","type":"actor/person/villager","name":{"en":"Benedicta Chalkrow","zh":"本笃塔·垩巷"},"place":{"on":"tile","map":"altar.highmoor.home-5","x":1,"y":1},"facing":"down","props":{"age":51,"household":"