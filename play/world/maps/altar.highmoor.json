oor.folk13"}},{"id":"altar.highmoor.folk14","type":"actor/person/farmer","name":{"en":"Benedict Whitehold","zh":"本笃·白堡"},"place":{"on":"tile","map":"altar.highmoor.home-8","x":1,"y":2},"facing":"down","props":{"age":57,"household":"altar.highmoor.h7","purse":5,"favourite":"item/food/mushroom/roasted"},"contents":["altar.highmoor.folk14.coin0","altar.highmoor.folk14.coin1","altar.highmoor.folk14.coin2","altar.highmoor.folk14.coin3","altar.highmoor.folk14.coin4"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.keen","beard":"beard.moustache","age":"age.lined","hat":"hat.straw","outfit":"outfit.workshirt"},"colors":{"skin":"warm","hair":"steelgrey","eyes":"storm","hat.1":"ochre","outfit.1":"woad","outfit.2":"slate"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":7,"map":"altar.highmoor.home-8","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"altar.highmoor","x":33,"y":21,"activity":"work"},{"from":12,"to":13,"map":"altar.highmoor.home-8","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.highmoor","x":33,"y":21,"activity":"work"},{"from":18,"to":21,"map":"altar.highmoor","x":20,"y":18,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.highmoor.folk14.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.highmoor.folk14"}},{"id":"altar.highmoor.folk14.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.highmoor.folk14"}},{"id":"alt