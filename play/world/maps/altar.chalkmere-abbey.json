ep"},{"from":7,"to":12,"map":"altar.chalkmere-abbey.cell-1","x":5,"y":1,"activity":"work"},{"from":12,"to":13,"map":"altar.chalkmere-abbey.cell-1","x":6,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.chalkmere-abbey.cell-1","x":5,"y":1,"activity":"work"},{"from":18,"to":21,"map":"altar.chalkmere-abbey","x":6,"y":29,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.chalkmere-abbey.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.chalkmere-abbey.folk0"}},{"id":"altar.chalkmere-abbey.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.chalkmere-abbey.folk0"}},{"id":"altar.chalkmere-abbey.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.chalkmere-abbey.folk0"}},{"id":"altar.chalkmere-abbey.folk1","type":"actor/person/priest","name":{"en":"Lucia Belldale","zh":"露西娅·钟谷"},"place":{"on":"tile","map":"altar.chalkmere-abbey.cell-2","x":1,"y":1},"facing":"down","props":{"age":53,"household":"altar.chalkmere-abbey.h1","purse":4,"favourite":"item/material/wax"},"contents":["altar.chalkmere-abbey.folk1.coin0","altar.chalkmere-abbey.folk1.coin1","altar.chalkmere-abbey.folk1.coin2","altar.chalkmere-abbey.folk1.coin3"],"look":{"body":"woman","parts":{"ha