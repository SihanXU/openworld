, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.ironbarrow.folk11.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk11"}},{"id":"redmarch.ironbarrow.folk11.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk11"}},{"id":"redmarch.ironbarrow.folk12","type":"actor/person/villager","name":{"en":"Katrin Rustward","zh":"卡特琳·锈守"},"place":{"on":"tile","map":"redmarch.ironbarrow","x":20,"y":22},"facing":"down","props":{"age":47,"household":"redmarch.ironbarrow.h6","purse":4,"favourite":"item/food/pie"},"contents":["redmarch.ironbarrow.folk12.coin0","redmarch.ironbarrow.folk12.coin1","redmarch.ironbarrow.folk12.coin2","redmarch.ironbarrow.folk12.coin3"],"look":{"body":"woman","parts":{"hair":"hair.bob","face":"face.weary","glasses":"glasses.round","outfit":"outfit.shawl","shoes":"shoes.buckled"},"colors":{"skin":"tan","hair":"steelgrey","eyes":"leaf","glasses.1":"bronze","outfit.1":"slate","outfit.2":"undyed","shoes.1":"plum"}},"npc":{"role":"villager","schedule":[{"from":21,"to":6,"map":"redmarch.ironbarrow.home-6","x":2,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.ironbarrow","x":20,"y":22,"activity":"work"},{"from":12,"to":13,"map":"redmarch.ironbarrow.home-6","x":6,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.ironbarrow","x":20,"y":22,"activity":"work"},{"from":18,"to":21,"map":"redmarch.ironbarrow.home-6","x":6,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.ironbarrow.folk12.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk12"}},{"id":"redmarch.ironbarrow.folk12.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk12"}},{"id":"redmarch.ironbarrow.folk12.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk12"}},{"id":"redmarch.ironbarrow.folk12.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk12"}},{"id":"redmarch.ironbarrow.folk13","type":"actor/person/villager","name":{"en":"Oksana Spearwood","zh":"奥克萨娜·矛林"},"place":{"on":"tile","map":"redmarch.ironbarrow","x":20,"y":13},"facing":"down","props":{"age":38,"household":"redmarch.ironbarrow.h7","purse":2,"favourite":"item/food/fish/catfish"},"contents":["redmarch.ironbarrow.folk13.coin0","redmarch.ironbarrow.folk13.coin1"],"look":{"body":"woman","parts":{"hair":"hair.cropped","face":"face.keen","mark":"mark.scar","outfit":"outfit.dress","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"umber","eyes":"leaf","outfit.1":"rose","outfit.2":"ivory","legs.1":"linen","shoes.1":"leather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":5,"map":"redmarch.ironbarrow.home-7","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.ironbarrow","x":20,"y":13,"activity":"work"},{"from":12,"to":13,"map":"redmarch.ironbarrow.home-7","x":7,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.ironbarrow","x":20,"y":13,"activity":"work"},{"from":18,"to":21,"map":"redmarch.ironbarrow","x":15,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"It gets dark earlier every day. Our lamp oil used to last till spring; this year I doubt it will see midwinter.","zh":"天黑得一天比一天早了。我家的灯油往年能点到开春，今年怕是撑不到冬至。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.ironbarrow.folk13.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk13"}},{"id":"redmarch.ironbarrow.folk13.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk13"}}]}