een a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.ironbarrow.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk0"}},{"id":"redmarch.ironbarrow.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk0"}},{"id":"redmarch.ironbarrow.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk0"}},{"id":"redmarch.ironbarrow.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk0"}},{"id":"redmarch.ironbarrow.folk1","type":"actor/person/farmer","name":{"en":"Gerhard Emberman","zh":"格哈德·烬人"},"place":{"on":"tile","map":"redmarch.ironbarrow","x":2,"y":12},"facing":"down","props":{"age":44,"household":"redmarch.ironbarrow.h0","purse":6,"favourite":"item/material/wool"},"contents":["redmarch.ironbarrow.folk1.coin0","redmarch.ironbarrow.folk1.coin1","redmarch.ironbarrow.folk1.coin2","redmarch.ironbarrow.folk1.coin3","redmarch.ironbarrow.folk1.coin4","redmarch.ironbarrow.folk1.coin5"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.weary","beard":"beard.full","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"umber","eyes":"hazel","outfit.1":"woad","outfit.2":"slate","shoes.1":"black"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":6,"map":"redmarch.ironbarrow.home-1","x":1,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.ironbarrow","x":2,"y":12,"activity":"work"},{"from":12,"to":13,"map":"redmarch.ironbarrow.home-1","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.ironbarrow","x":2,"y":12,"activity":"work"},{"from":18,"to":22,"map":"redmarch.ironbarrow","x":23,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.ironbarrow.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk1"}},{"id":"redmarch.ironbarrow.folk2","type":"actor/person/elder","name":{"en":"Ilka Steelhill","zh":"伊尔卡·钢丘"},"place":{"on":"tile","map":"redmarch.ironbarrow.home-2","x":3,"y":2},"facing":"down","props":{"age":74,"household":"redmarch.ironbarrow.h1","purse":3,"favourite":"item/food/meat/cooked"},"contents":["redmarch.ironbarrow.folk2.coin0","redmarch.ironbarrow.folk2.coin1","redmarch.ironbarrow.folk2.coin2"],"look":{"body":"woman","parts":{"hair":"hair.bun","face":"face.weary","age":"age.lined","outfit":"outfit.shawl","shoes":"shoes.boots"},"colors":{"skin":"deep","hair":"silver","eyes":"sky","outfit.1":"slate","outfit.2":"undyed","shoes.1":"leather"}},"npc":{"role":"elder","schedule":[{"from":21,"to":7,"map":"redmarch.ironbarrow.home-2","x":3,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.ironbarrow.home-2","x":9,"y":4,"activity":"sit"},{"from":12,"to":13,"map":"redmarch.ironbarrow.home-2","x":6,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.ironbarrow.home-2","x":9,"y":4,"activity":"sit"},{"from":18,"to":21,"map":"redmarch.ironbarrow.home-2","x":6,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.ironbarrow.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk2"}},{"id":"redmarch.ironbarrow.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk2"}},{"id":"redmarch.ironbarrow.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.ironbarrow.folk2"}},{"id":"redmarch.ironbarrow.folk3","type":"actor/person/child","name":{"en":"Vesna Steelhill","zh":"韦斯娜·钢丘"},"place":{"on":"tile","map":"redmarch.ironbarrow.home-2","x":2,"y":2},"facing":"down","props":{"age":15,"household":"redmarch.ironbarrow.h1","purse":1,"favourite":"item/material/herb"},"tags":["minor"],"contents":["redmarch.ironbarrow.folk3.coin0"],"look":{"body":"woman","parts":{"hair":"h