x":6,"y":28,"activity":"work"},{"from":12,"to":13,"map":"redmarch.ironbarrow.home-5","x":7,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.ironbarrow","x":6,"y":28,"activity":"work"},{"from":18,"to":21,"map":"redmarch.ironbarrow","x":34,"y":24,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Feverfew for headaches, yarrow to stop bleeding. Both are slow to come up this year; I have to go deeper into the woods to gather enough.","zh":"小白菊治头疼，蓍草止血。这两样今年都长得慢，我得往林子深处走才采得够。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"type":"item/material/herb","id":"redmarch.ironbarrow.folk9.s0.0","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/material/herb","id":"redmarch.ironbarrow.folk9.s0.1","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/material/herb","id":"redmarch.ironbarrow.folk9.s0.2","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/material/herb","id":"redmarch.ironbarrow.folk9.s0.3","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/food/berries","id":"redmarch.ironbarrow.folk9.s1.0","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/food/berries","id":"redmarch.ironbarrow.folk9.s1.1","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/food/berries","id":"redmarch.ironbarrow.folk9.s1.2","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/food/berries","id":"redmarch.ironbarrow.folk9.s1.3","place":{"on":"inside","holder":"redmarch.ironbarrow.folk9"}},{"type":"item/potion/healing","id":"redmarch.ironbarrow.folk9.s2.0","place":{"o