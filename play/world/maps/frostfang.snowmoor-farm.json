g.snowmoor-farm.folk0.coin0","frostfang.snowmoor-farm.folk0.coin1","frostfang.snowmoor-farm.folk0.coin2"],"look":{"body":"woman","parts":{"hair":"hair.ponytail","face":"face.bright","mark":"mark.scar","glasses":"glasses.round","hat":"hat.straw","outfit":"outfit.workdress","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"auburn","eyes":"violet","glasses.1":"gold","hat.1":"mustard","outfit.1":"russet","outfit.2":"linen","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":6,"map":"frostfang.snowmoor-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"frostfang.snowmoor-farm","x":29,"y":11,"activity":"work"},{"from":12,"to":13,"map":"frostfang.snowmoor-farm.farmhouse-1","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.snowmoor-farm","x":29,"y":11,"activity":"work"},{"from":18,"to":22,"map":"frostfang.snowmoor-farm","x":3,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"weather:storm","text":{"en":"Storm off the sea. Stack the wood high and keep the shutters shut.","zh":"海上起风暴了。柴堆高，窗板关好。"}}]}}},{"id":"frostfang.snowmoor-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk0"}},{"id":"frostfang.snowmoor-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk0"}},{"id":"frostfang.snowmoor-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk0"}},{"id":"frostfang.snowmoor-farm.folk1","type":"actor/person/farmer","name":{"en":"Ingrid Greywell","zh":"英格丽·灰井"},"place":{"on":"tile","map":