thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk1"}},{"id":"frostfang.snowmoor-farm.folk2","type":"actor/person/child","name":{"en":"Sten Greywell","zh":"斯滕·灰井"},"place":{"on":"tile","map":"frostfang.snowmoor-farm.farmhouse-1","x":2,"y":2},"facing":"down","props":{"age":11,"household":"frostfang.snowmoor-farm.h0","purse":1,"favourite":"item/food/berries"},"tags":["minor"],"contents":["frostfang.snowmoor-farm.folk2.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"honey","eyes":"hazel","outfit.1":"rose","legs.1":"linen","shoes.1":"umber"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"frostfang.snowmoor-farm.farmhouse-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"frostfang.snowmoor-farm","x":11,"y":12,"activity":"play"},{"from":12,"to":13,"map":"frostfang.snowmoor-farm.farmhouse-1","x":7,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.snowmoor-farm","x":11,"y":12,"activity":"play"},{"from":18,"to":20,"map":"frostfang.snowmoor-farm.farmhouse-1","x":7,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"They say there's a knight on the road past Vesper Ford who stops everyone. Nobody gets by him.","zh":"听说过了晚祷渡的那条大路上，有个骑士把路拦住了，谁也过不去。"}}]}}},{"id":"frostfang.snowmoor-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.snowmoor-farm.folk2"}}]}