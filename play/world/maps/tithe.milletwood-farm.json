,"place":{"on":"inside","holder":"tithe.milletwood-farm.folk0"}},{"id":"tithe.milletwood-farm.folk0.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk0"}},{"id":"tithe.milletwood-farm.folk1","type":"actor/person/farmer","name":{"en":"Simon Saltford","zh":"西蒙·盐渡"},"place":{"on":"tile","map":"tithe.milletwood-farm.farmhouse-1","x":3,"y":1},"facing":"down","props":{"age":47,"household":"tithe.milletwood-farm.h0","purse":2,"favourite":"item/food/honey"},"contents":["tithe.milletwood-farm.folk1.coin0","tithe.milletwood-farm.folk1.coin1"],"look":{"body":"man","parts":{"hair":"hair.messy","face":"face.stern","hat":"hat.straw","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"fair","hair":"steelgrey","eyes":"sky","hat.1":"mustard","outfit.1":"woad","outfit.2":"slate","shoes.1":"black"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"tithe.milletwood-farm.farmhouse-1","x":3,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.milletwood-farm","x":21,"y":12,"activity":"work"},{"from":12,"to":13,"map":"tithe.milletwood-farm.farmhouse-1","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.milletwood-farm","x":21,"y":12,"activity":"work"},{"from":18,"to":22,"map":"tithe.milletwood-farm","x":34,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.milletwood-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk1"}},{"id":"tithe.milletwood-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk1"}},{"id":"tithe.milletwood-farm.folk2","type":"actor/person/elder","name":{"en":"Wat Saltford","zh":"瓦特·盐渡"},"place":{"on":"tile","map":"tithe.milletwood-farm","x":35,"y":22},"facing":"down","props":{"age":62,"household":"tithe.milletwood-farm.h0","purse":6,"favourite":"item/material/salt"},"contents":["tithe.milletwood-farm.folk2.coin0","tithe.milletwood-farm.folk2.coin1","tithe.milletwood-farm.folk2.coin2","tithe.milletwood-farm.folk2.coin3","tithe.milletwood-farm.folk2.coin4","tithe.milletwood-farm.folk2.coin5"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.stern","beard":"beard.stubble","age":"age.lined","hat":"hat.cap","outfit":"outfit.tunic","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"snow","eyes":"amber","hat.1":"linen","outfit.1":"woad","shoes.1":"black"}},"npc":{"role":"elder","schedule":[{"from":22,"to":5,"map":"tithe.milletwood-farm.farmhouse-1","x":1,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"tithe.milletwood-farm","x":35,"y":22,"activity":"sit"},{"from":12,"to":13,"map":"tithe.milletwood-farm.farmhouse-1","x":3,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.milletwood-farm","x":35,"y":22,"activity":"sit"},{"from":18,"to":22,"map":"tithe.milletwood-farm.farmhouse-1","x":3,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.milletwood-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk2.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk2.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk2"}},{"id":"tithe.milletwood-farm.folk3","type":"actor/person/child","name":{"en":"Piers Saltford","zh":"皮尔斯·盐渡"},"place":{"on":"tile","map":"tithe.milletwood-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":10,"household":"tithe.milletwood-farm.h0","purse":1,"favourite":"item/food/pie"},"tags":["minor"],"contents":["tithe.milletwood-farm.folk3.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","legs":"legs.wraps","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"black","eyes":"leaf","outfit.1":"woad","legs.1":"slate","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"tithe.milletwood-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"tithe.milletwood-farm","x":5,"y":6,"activity":"play"},{"from":12,"to":13,"map":"tithe.milletwood-farm.farmhouse-1","x":4,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.milletwood-farm","x":5,"y":6,"activity":"play"},{"from":18,"to":20,"map":"tithe.milletwood-farm.farmhouse-1","x":4,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.milletwood-farm.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.milletwood-farm.folk3"}}]}