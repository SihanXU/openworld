"},{"from":18,"to":21,"map":"redmarch.rustholm-shrine","x":20,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustholm-shrine.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustholm-shrine.folk2"}},{"id":"redmarch.rustholm-shrine.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustholm-shrine.folk2"}},{"id":"redmarch.rustholm-shrine.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustholm-shrine.folk2"}},{"id":"redmarch.rustholm-shrine.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustholm-shrine.folk2"}}]}