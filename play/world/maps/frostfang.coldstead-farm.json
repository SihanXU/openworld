folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk0"}},{"id":"frostfang.coldstead-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk0"}},{"id":"frostfang.coldstead-farm.folk1","type":"actor/person/farmer","name":{"en":"Runa Snowman","zh":"鲁娜·雪人"},"place":{"on":"tile","map":"frostfang.coldstead-farm","x":18,"y":7},"facing":"down","props":{"age":22,"household":"frostfang.coldstead-farm.h0","purse":5,"favourite":"item/material/herb"},"contents":["frostfang.coldstead-farm.folk1.coin0","frostfang.coldstead-farm.folk1.coin1","frostfang.coldstead-farm.folk1.coin2","frostfang.coldstead-farm.folk1.coin3","frostfang.coldstead-farm.folk1.coin4"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.keen","mark":"mark.freckles","hat":"hat.straw","outfit":"outfit.workdress","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"gold","eyes":"leaf","hat.1":"ochre","outfit.1":"linen","outfit.2":"linen","legs.1":"umber","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":5,"map":"frostfang.coldstead-farm.farmhouse-1","x":4,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"frostfang.coldstead-farm","x":18,"y":7,"activity":"work"},{"from":12,"to":13,"map":"frostfang.coldstead-farm.farmhouse-1","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldstead-farm","x":18,"y":7,"activity":"work"},{"from":18,"to":22,"map":"frostfang.coldstead-farm","x":23,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"weather:storm","text":{"en":"Storm off the sea. Stack the wood high and keep the shutters shut.","zh":"海上起风暴了。柴堆高，窗板关好。"}}]}}},{"id":"frostfang.coldstead-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk1"}},{"id":"frostfang.coldstead-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk1"}},{"id":"frostfang.coldstead-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk1"}},{"id":"frostfang.coldstead-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk1"}},{"id":"frostfang.coldstead-farm.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk1"}},{"id":"frostfang.coldstead-farm.folk2","type":"actor/person/child","name":{"en":"Ivar Snowman","zh":"伊瓦尔·雪人"},"place":{"on":"tile","map":"frostfang.coldstead-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":7,"household":"frostfang.coldstead-farm.h0","purse":1,"favourite":"item/misc/dice"},"tags":["minor"],"contents":["frostfang.coldstead-farm.folk2.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","shoes":"shoes.shoes"},"colors":{"skin":"deep","hair":"rose","eyes":"hazel","outfit.1":"woad","shoes.1":"black"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"frostfang.coldstead-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"frostfang.coldstead-farm.farmhouse-1","x":4,"y":4,"activity":"play"},{"from":12,"to":13,"map":"frostfang.coldstead-farm.farmhouse-1","x":3,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldstead-farm.farmhouse-1","x":4,"y":4,"activity":"play"},{"from":18,"to":20,"map":"frostfang.coldstead-farm.farmhouse-1","x":3,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"They say there's a knight on the road past Vesper Ford who stops everyone. Nobody gets by him.","zh":"听说过了晚祷渡的那条大路上，有个骑士把路拦住了，谁也过不去。"}}]}}},{"id":"frostfang.coldstead-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldstead-farm.folk2"}},{"id":"frostfang.coldstead-farm.folk3","type":"actor/person/child","name":{"en":"Liv Snowman","zh":"莉芙·雪人"},"place":{"on":"tile","map":"frostfang.coldstead-farm.farmhouse-1","x":2,"y":1},"facing":"down","props":{"age":6,"household":"frostfang.coldstead-farm.h0","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["frostfang.coldstead-farm.folk3.coin0"],"look":{"body":"girl","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.pinafore"},"colors":{"skin":"fair","hair":"black","eyes":"bark","outfit.1":"rose"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"frostfang.coldstead-farm.farmhouse-1","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"frostfang.coldstead-farm.farmhouse-1","x":6,"y":4,"activity":"play"},{"from":12,"to":13,"map":"frostfang.coldstead-farm.farmhouse-1","x":6,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldstead-farm.farmhouse-1","x":6,"y":4,"activity":"play"},{"from":18,"to":20,"map":"frostfang.coldstead-farm.farmhouse-1","x":6,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":