18,"to":22,"map":"redmarch.rustmere.home-6","x":4,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.rustmere.folk13.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk13.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk13.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk13.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk13.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk13.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk13"}},{"id":"redmarch.rustmere.folk14","type":"actor/person/beggar","name":{"en":"Gerhard Emberstone","zh":"格哈德·烬石"},"place":{"on":"tile","map":"redmarch.rustmere","x":34,"y":26},"facing":"down","props":{"age":56,"household":"redmarch.rustmere.h7","purse":0,"favourite":"item/food/fish/eel"},"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.stern","beard":"beard.full","age":"age.lined","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"brown","hair":"steelgrey","eyes":"sky","outfit.1":"undyed","outfit.2":"slate","shoes.1":"darkleather"}},"npc":{"role":"beggar","schedule":[{"from":22,"to":5,"map":"redmarch.rustmere.home-7","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.rustmere","x":34,"y":26,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-7","x":3,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":34,"y":26,"activity":"work"},{"from":18,"to":22,"map":"redmarch.rustmere.home-7","x":3,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Spare a coin, please, or a crust of bread. Even the soup tent has been shut these past few days.","zh":"行行好，给一枚钱吧，一块干面包也行。这几天连施粥的棚子都关了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}}]}