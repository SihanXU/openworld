re~8"}},{"id":"redmarch.rustmere.folk0","type":"actor/person/elder","name":{"en":"Oksana Ironstone","zh":"奥克萨娜·铁石"},"place":{"on":"tile","map":"redmarch.rustmere.home-1","x":1,"y":2},"facing":"down","props":{"age":77,"household":"redmarch.rustmere.h0","purse":4,"favourite":"item/food/cheese"},"contents":["redmarch.rustmere.folk0.coin0","redmarch.rustmere.folk0.coin1","redmarch.rustmere.folk0.coin2","redmarch.rustmere.folk0.coin3"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.soft","age":"age.lined","outfit":"outfit.shawl","legs":"legs.hose","shoes":"shoes.tall"},"colors":{"skin":"tan","hair":"silver","eyes":"amber","outfit.1":"slate","outfit.2":"linen","legs.1":"slate","shoes.1":"black"}},"npc":{"role":"elder","schedule":[{"from":21,"to":7,"map":"redmarch.rustmere.home-1","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere.home-1","x":1,"y":4,"activity":"sit"},{"from":12,"to":13,"map":"redmarch.rustmere.home-1","x":6,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere.home-1","x":1,"y":4,"activity":"sit"},{"from":18,"to":21,"map":"redmarch.rustmere.home-1","x":6,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk0"}},{"id":"redmarch.rustmere.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk0"}},{"id":"redmarch.rustmere.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk0"}},{"id":"redmarch.rustmere.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk0"}},{"id":"redmarch.rustmere.folk1","type":"actor/person/hunter","name":{"en":"Ottokar Ironstone","zh":"奥托卡·铁石"},"place":{"on":"tile","map":"redmarch.rustmere.home-1","x":1,"y":1},"facing":"down","props":{"age":47,"household":"redmarch.rustmere.h0","purse":5,"favourite":"item/food/ale","fights":true},"contents":["redmarch.rustmere.folk1.coin0","redmarch.rustmere.folk1.coin1","redmarch.rustmere.folk1.coin2","redmarch.rustmere.folk1.coin3","redmarch.rustmere.folk1.coin4"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","beard":"beard.stubble","mark":"mark.scar","outfit":"outfit.cloak","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"ash","eyes":"bark","outfit.1":"umber","legs.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"hunter","schedule":[{"from":21,"to":7,"map":"redmarch.rustmere.home-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere","x":38,"y":8,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-1","x":7,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":38,"y":8,"activity":"work"},{"from":18,"to":21,"map":"redmarch.rustmere.home-1","x":7,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"If you go into the woods, keep clear of the spots marked with red rags. Those are my snares.","zh":"你要进林子的话，绕开那些挂了红布条的地方，那是我下的套子。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.rustmere.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk1"}},{"id":"redmarch.rustmere.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk1"}},{"id":"redmarch.rustmere.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk1"}},{"id":"redmarch.rustmere.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk1"}},{"id":"redmarch.rustmere.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk1"}},{"id":"redmarch.rustmere.folk2","type":"actor/person/villager","name":{"en":"Jelka Reddale","zh":"耶尔卡·赤谷"},"place":{"on":"tile","map":"redmarch.rustmere","x":9,"y":16},"facing":"down","props":{"age":30,"household":"redmarch.rustmere.h1","purse":5,"favourite":"item/material/cloth"},"contents":["redmarch.rustmere.folk2.coin0","redmarch.rustmere.folk2.coin1","redmarch.rustmere.folk2.coin2","redmarch.rustmere.folk2.coin3","redmarch.rustmere.folk2.coin4"],"look":{"body":"woman","parts":{"hair":"hair.messy","face":"face.keen","outfit":"outfit.dress","legs":"legs.stockings","shoes":"shoes.shoes"},"colors":{"skin":"brown","hair":"gold","eyes":"leaf","outfit.1":"umber","outfit.2":"undyed","legs.1":"charcoal","shoes.1":"umber"}},"npc":{"role":"villager","schedule":[{"from":21,"to":5,"map":"redmarch.rustmere.home-2","x":4,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.rustmere","x":9,"y":16,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-2","x":4,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":9,"y":16,"activity":"work"},{"from":18,"to":21,"map":"redmarch.rustmere.home-2","x":4,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk2"}},{"id":"redmarch.rustmere.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk2"}},{"id":"redmarch.rustmere.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk2"}},{"id":"redmarch.rustmere.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk2"}},{"id":"redmarch.rustmere.folk2.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk2"}},{"id":"redmarch.rustmere.folk3","type":"actor/person/elder","name":{"en":"Vuk Reddale","zh":"武克·赤谷"},"place":{"on":"tile","map":"redmarch.rustmere","x":12,"y":23},"facing":"down","props":{"age":68,"household":"redmarch.rustmere.h1","purse":3,"favourite":"item/misc/bell"},"contents":["redmarch.rustmere.folk3.coin0","redmarch.rustmere.folk3.coin1","redmarch.rustmere.folk3.coin2"],"look":{"body":"man","parts":{"hair":"hair.thin","face":"face.weary","age":"age.lined","outfit":"outfit.workshirt","legs":"legs.hose","shoes":"shoes.tall"},"colors":{"skin":"warm","hair":"silver","eyes":"leaf","outfit.1":"woad","outfit.2":"moss","legs.1":"linen","shoes.1":"black"}},"npc":{"role":"elder","schedule":[{"from":21,"to":6,"map":"redmarch.rustmere.home-2","x":2,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.rustmere","x":12,"y":23,"activity":"sit"},{"from":12,"to":13,"map":"redmarch.rustmere.home-2","x":7,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":12,"y":23,"activity":"sit"},{"from":18,"to":21,"map":"redmarch.rustmere","x":6,"y":16,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.rustmere.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk3"}},{"id":"redmarch.rustmere.folk3.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk3"}},{"id":"redmarch.rustmere.folk3.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk3"}},{"id":"redmarch.rustmere.folk4","type":"actor/person/child","name":{"en":"Ratko Reddale","zh":"拉特科·赤谷"},"place":{"on":"tile","map":"redmarch.rustmere.home-2","x":1,"y":1},"facing":"down","props":{"age":6,"household":"redmarch.rustmere.h1","purse":1,"favourite":"item/misc/flute"},"tags":["minor"],"contents":["redmarch.rustmere.folk4.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","mark":"mark.freckles","outfit":"outfit.smock","shoes":"shoes.boots"},"colors":{"skin":"fair","hair":"chestnut","eyes":"leaf","outfit.1":"rose","shoes.1":"darkleather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"redmarch.rustmere.home-2","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere.home-2","x":3,"y":5,"activity":"play"},{"from":12,"to":13,"map":"redmarch.rustmere.home-2","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere.home-2","x":3,"y":5,"activity":"play"},{"from":18,"to":20,"map":"redmarch.rustmere.home-2","x":5,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk4.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk4"}},{"id":"redmarch.rustmere.folk5","type":"actor/person/smith","name":{"en":"Ratko Flintwell","zh":"拉特科·燧井"},"place":{"on":"tile","map":"redmarch.rustmere.smithy-1","x":1,"y":1},"facing":"down","props":{"age":29,"household":"redmarch.rustmere.h2","purse":10,"favourite":"item/gem","fights":true,"stock":"item/tool/pickaxe*1|item/tool/hoe*1|item/weapon/blade/dagger*1|item/material/iron_ingot*2"},"tags":["merchant"],"contents":["redmarch.rustmere.folk5.s0.0","redmarch.rustmere.folk5.s1.0","redmarch.rustmere.folk5.s2.0","redmarch.rustmere.folk5.s3.0","redmarch.rustmere.folk5.s3.1","redmarch.rustmere.folk5.coin0","redmarch.rustmere.folk5.coin1","redmarch.rustmere.folk5.coin2