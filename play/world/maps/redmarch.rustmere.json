re.folk7"}},{"id":"redmarch.rustmere.folk7.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk7"}},{"id":"redmarch.rustmere.folk7.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk7"}},{"id":"redmarch.rustmere.folk8","type":"actor/person/villager","name":{"en":"Lothar Ashrow","zh":"洛塔尔·灰巷"},"place":{"on":"tile","map":"redmarch.rustmere.home-4","x":2,"y":2},"facing":"down","props":{"age":23,"household":"redmarch.rustmere.h4","purse":5,"favourite":"item/food/wine"},"contents":["redmarch.rustmere.folk8.coin0","redmarch.rustmere.folk8.coin1","redmarch.rustmere.folk8.coin2","redmarch.rustmere.folk8.coin3","redmarch.rustmere.folk8.coin4"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.keen","outfit":"outfit.tunic","legs":"legs.hose"},"colors":{"skin":"brown","hair":"black","eyes":"sky","outfit.1":"umber","legs.1":"linen"}},"npc":{"role":"villager","schedule":[{"from":21,"to":7,"map":"redmarch.rustmere.home-4","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere","x":2,"y":25,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-4","x":5,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":2,"y":25,"activity":"work"},{"from":18,"to":21,"map":"redmarch.rustmere.home-4","x":5,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk8.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk8"}},{"id":"redmarch.rustmere.folk8.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk8"}},{"id":"redmarch.rustmere.folk8.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk8"}},{"id":"redmarch.rustmere.folk8.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk8"}},{"id":"redmarch.rustmere.folk8.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk8"}},{"id":"redmarch.rustmere.folk9","type":"actor/person/villager","name":{"en":"Mirka Ashrow","zh":"米尔卡·灰巷"},"place":{"on":"tile","map":"redmarch.rustmere.home-4","x":1,"y":1},"facing":"down","props":{"age":51,"household":"redmarch.rustmere.h4","purse":5,"favourite":"item/food/berries"},"contents":["redmarch.rustmere.folk9.coin0","redmarch.rustmere.folk9.coin1","redmarch.rustmere.folk9.coin2","redmarch.rustmere.folk9.coin3","redmarch.rustmere.folk9.coin4"],"look":{"body":"woman","parts":{"hair":"hair.bob","face":"face.weary","outfit":"outfit.shawl","legs":"legs.stockings","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"silver","eyes":"leaf","outfit.1":"plum","outfit.2":"linen","legs.1":"umber","shoes.1":"darkleather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":7,"map":"redmarch.rustmere.home-4","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere","x":12,"y":10,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-4","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":12,"y":10,"activity":"work"},{"from":18,"to":21,"map":"redmarch.rustmere.home-4","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"It gets dark earlier every day. Our lamp oil used to last till spring; this year I doubt it will see midwinter.","zh":"天黑得一天比一天早了。我家的灯油往年能点到开春，今年怕是撑不到冬至。"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk9.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk9"}},{"id":"redmarch.rustmere.folk9.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk9"}},{"id":"redmarch.rustmere.folk9.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk9"}},{"id":"redmarch.rustmere.folk9.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk9"}},{"id":"redmarch.rustmere.folk9.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk9"}},{"id":"redmarch.rustmere.folk10","type":"actor/person/farmer","name":{"en":"Radomir Hawkhill","zh":"拉多米尔·鹰丘"},"place":{"on":"tile","map":"redmarch.rustmere","x":11,"y":24},"facing":"down","props":{"age":46,"household":"redmarch.rustmere.h5","purse":2,"favourite":"item/vessel/flask/holy_water"},"contents":["redmarch.rustmere.folk10.coin0","redmarch.rustmere.folk10.coin1"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.keen","hat":"hat.straw","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"steelgrey","eyes":"storm","hat.1":"ochre","outfit.1":"undyed","outfit.2":"moss","shoes.1":"leather"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"redmarch.rustmere.home-5","x":2,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.rustmere","x":11,"y":24,"activity":"work"},{"from":12,"to":13,"map":"redmarch.rustmere.home-5","x":7,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":11,"y":24,"activity":"work"},{"from":18,"to":21,"map":"redmarch.rustmere.home-5","x":7,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.rustmere.folk10.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk10"}},{"id":"redmarch.rustmere.folk10.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk10"}},{"id":"redmarch.rustmere.folk11","type":"actor/person/child","name":{"en":"Vesna Hawkhill","zh":"韦斯娜·鹰丘"},"place":{"on":"tile","map":"redmarch.rustmere.home-5","x":2,"y":2},"facing":"down","props":{"age":12,"household":"redmarch.rustmere.h5","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["redmarch.rustmere.folk11.coin0"],"look":{"body":"girl","parts":{"hair":"hair.pigtails","face":"face.child","outfit":"outfit.pinafore","legs":"legs.hose","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"black","eyes":"amber","outfit.1":"moss","legs.1":"slate","shoes.1":"black"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"redmarch.rustmere.home-5","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.rustmere","x":13,"y":25,"activity":"play"},{"from":12,"to":13,"map":"redmarch.rustmere.home-5","x":3,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.rustmere","x":13,"y":25,"activity":"play"},{"from":18,"to":20,"map":"redmarch.rustmere.home-5","x":3,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.rustmere.folk11.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.rustmere.folk11"}},{"id":"redmarch.rustmere.folk12","type":"actor/person/herbalist","name":{"en":"Milos Flintcroft","zh":"米洛什·燧园"},"place":{"on":"tile","map":"redmarch.rustmere.home-6","x":2,"y":2},"facing":"down","props":{"age":26,"household":"redmarch.rustmere.h6","purse":2,"favourite":"item/food/fish/perch","stock":"item/material/herb*4|item/food/berries*4|item/potion/healing*1"},"tags":["merchant"],"contents":["redmarch.rustmere.folk12.s0.0","redmarch.rustmere.folk12.s0.1","redmarch.rustmere.folk12.s0.2","redmarch.rustmere.folk12.s0.3","redmarch.rustmere.folk12.s1.0","redmarch.rustmere.folk12.s1.1","redmarch.rustmere.folk12.s1.2","redmar