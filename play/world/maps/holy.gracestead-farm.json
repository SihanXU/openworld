":36,"y":12,"activity":"work"},{"from":18,"to":21,"map":"holy.gracestead-farm.farmhouse-1","x":6,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.gracestead-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk0"}},{"id":"holy.gracestead-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk0"}},{"id":"holy.gracestead-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk0"}},{"id":"holy.gracestead-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk0"}},{"id":"holy.gracestead-farm.folk1","type":"actor/person/farmer","name":{"en":"Helena Lambman","zh":"海伦娜·羔人"},"place":{"on":"tile","map":"holy.gracestead-farm","x":36,"y":26},"facing":"down","props":{"age":52,"household":"holy.gracestead-farm.h0","purse":3,"favourite":"item/food/fish/perch"},"contents":["holy.gracestead-farm.folk1.coin0","holy.gracestead-farm.folk1.coin1","holy.gracestead-farm.folk1.coin2"],"look":{"body":"woman","parts":{"hair":"hair.bun","face":"face.keen","mark":"mark.scar","hat":"hat.kerchief","outfit":"outfit.shawl","shoes":"shoes.buckled"},"colors":{"skin":"tan","hair":"steelgrey","eyes":"hazel","hat.1":"moss","outfit.1":"umber","outfit.2":"undyed","shoes.1":"plum"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"holy.gracestead-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"holy.gracestead-farm","x":36,"y":26,"activity":"work"},{"from":12,"to":13,"map":"holy.gracestead-farm.farmhouse-1","x":6,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracestead-farm","x":36,"y":26,"activity":"work"},{"from":18,"to":21,"map":"holy.gracestead-farm.farmhouse-1","x":6,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.gracestead-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk1"}},{"id":"holy.gracestead-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk1"}},{"id":"holy.gracestead-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk1"}},{"id":"holy.gracestead-farm.folk2","type":"actor/person/child","name":{"en":"Lucian Lambman","zh":"卢锡安·羔人"},"place":{"on":"tile","map":"holy.gracestead-farm.farmhouse-1","x":4,"y":2},"facing":"down","props":{"age":7,"household":"holy.gracestead-farm.h0","purse":1,"favourite":"item/misc/flute"},"tags":["minor"],"contents":["holy.gracestead-farm.folk2.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"umber","eyes":"violet","outfit.1":"slate","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.gracestead-farm.farmhouse-1","x":4,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.gracestead-farm.farmhouse-1","x":7,"y":4,"activity":"play"},{"from":12,"to":13,"map":"holy.gracestead-farm.farmhouse-1","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracestead-farm.farmhouse-1","x":7,"y":4,"activity":"play"},{"from":18,"to":20,"map":"holy.gracestead-farm","x":3,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.gracestead-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracestead-farm.folk2"}}]}