x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.pilgrimbarrow","x":8,"y":19,"activity":"work"},{"from":12,"to":13,"map":"holy.pilgrimbarrow.home-1","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.pilgrimbarrow","x":8,"y":19,"activity":"work"},{"from":18,"to":21,"map":"holy.pilgrimbarrow","x":31,"y":23,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.pilgrimbarrow.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk1"}},{"id":"holy.pilgrimbarrow.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk1"}},{"id":"holy.pilgrimbarrow.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk1"}},{"id":"holy.pilgrimbarrow.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk1"}},{"id":"holy.pilgrimbarrow.folk2","type":"actor/person/villager","name":{"en":"Zenobia Myrrhstone","zh":"芝诺比娅·没药石"},"place":{"on":"tile","map":"holy.pilgrimbarrow.home-2","x":7,"y":5},"facing":"down","props":{"age":56,"household":"holy.pilgrimbarrow.h1","purse":6,"favourite":"item/food/fish/sunfish"},"contents":["holy.pilgrimbarrow.folk2.coin0","holy.pilgrimbarrow.folk2.coin1","holy.pil