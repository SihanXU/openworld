":"down","props":{"age":29,"household":"holy.pilgrimbarrow.h7","purse":4,"favourite":"item/light/lantern"},"contents":["holy.pilgrimbarrow.folk13.coin0","holy.pilgrimbarrow.folk13.coin1","holy.pilgrimbarrow.folk13.coin2","holy.pilgrimbarrow.folk13.coin3"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.bright","glasses":"glasses.round","hat":"hat.straw","outfit":"outfit.workdress","shoes":"shoes.boots"},"colors":{"skin":"porcelain","hair":"honey","eyes":"storm","glasses.1":"bronze","hat.1":"ochre","outfit.1":"moss","outfit.2":"undyed","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"holy.pilgrimbarrow.home-8","x":4,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.pilgrimbarrow","x":4,"y":28,"activity":"work"},{"from":12,"to":13,"map":"holy.pilgrimbarrow.home-8","x":5,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.pilgrimbarrow","x":4,"y":28,"activity":"work"},{"from":18,"to":22,"map":"holy.pilgrimbarrow.home-8","x":5,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.pilgrimbarrow.folk13.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk13"}},{"id":"holy.pilgrimbarrow.folk13.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk13"}},{"id":"holy.pilgrimbarrow.folk13.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk13"}},{"id":"holy.pilgrimbarrow.folk13.coin3","type":"item/misc