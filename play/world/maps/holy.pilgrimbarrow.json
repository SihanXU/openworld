storm","outfit.1":"linen","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.pilgrimbarrow.home-6","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.pilgrimbarrow","x":18,"y":17,"activity":"play"},{"from":12,"to":13,"map":"holy.pilgrimbarrow.home-6","x":3,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.pilgrimbarrow","x":18,"y":17,"activity":"play"},{"from":18,"to":20,"map":"holy.pilgrimbarrow","x":12,"y":24,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.pilgrimbarrow.folk10.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk10"}},{"id":"holy.pilgrimbarrow.folk11","type":"actor/person/hunter","name":{"en":"Zenobia Goldhold","zh":"芝诺比娅·金堡"},"place":{"on":"tile","map":"holy.pilgrimbarrow","x":1,"y":2},"facing":"down","props":{"age":44,"household":"holy.pilgrimbarrow.h6","purse":6,"favourite":"item/material/fireweed","fights":true},"contents":["holy.pilgrimbarrow.folk11.coin0","holy.pilgrimbarrow.folk11.coin1","holy.pilgrimbarrow.folk11.coin2","holy.pilgrimbarrow.folk11.coin3","holy.pilgrimbarrow.folk11.coin4","holy.pilgrimbarrow.folk11.coin5"],"look":{"body":"woman","parts":{"hair":"hair.bun","face":"face.soft","hat":"hat.hood","outfit":"outfit.cloak","shoes":"shoes.tall"},"colors":{"skin":"tan","hair":"honey","eyes":"storm","hat.1":"slate","outfit.1":"forest","shoes.1":"darkleather"}},"npc":{"role":"hunter","schedule":[{"from":21,"to":6,"map":"holy.pilgrimbarrow.home-7","x":2,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"holy.pilgrimbarrow","x":1,"y":2,"activity":"work"},{"from":12,"to":13,"map":"holy.pilgrimbarrow.home-7","x":4,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.pilgrimbarrow","x":1,"y":2,"activity":"work"},{"from":18,"to":21,"map":"holy.pilgrimbarrow.home-7","x":4,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Half the deer in the woods are gone, and there are tracks I can't put a name to. Big ones. I'm back before dark now.","zh":"林子里的鹿少了一大半，倒多了些我叫不出名字的脚印，个头不小。我现在都赶在天黑前回来。"}},{"key":"default","text":{"en":"If you go into the woods, keep clear of the spots marked with red rags. Those are my snares.","zh":"你要进林子的话，绕开那些挂了红布条的地方，那是我下的套子。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.pilgrimbarrow.folk11.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk11.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk11.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk11.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk11.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk11.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.pilgrimbarrow.folk11"}},{"id":"holy.pilgrimbarrow.folk12","type":