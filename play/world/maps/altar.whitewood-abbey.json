:"fixture/sacred/statue","place":{"on":"tile","map":"altar.whitewood-abbey","x":25,"y":15}},{"id":"altar.whitewood-abbey~b","type":"fixture/sacred/statue","place":{"on":"tile","map":"altar.whitewood-abbey","x":22,"y":16}},{"id":"altar.whitewood-abbey~c","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":13,"y":27}},{"id":"altar.whitewood-abbey~d","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":16,"y":27}},{"id":"altar.whitewood-abbey~e","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":19,"y":27}},{"id":"altar.whitewood-abbey~f","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":22,"y":27}},{"id":"altar.whitewood-abbey~g","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":25,"y":27}},{"id":"altar.whitewood-abbey~h","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":28,"y":27}},{"id":"altar.whitewood-abbey~i","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"altar.whitewood-abbey","x":31,"y":27}},{"id":"altar.whitewood-abbey.folk0","type":"actor/person/priest","name":{"en":"Cecilia Lilywell","zh":"塞西莉亚·百合井"},"place":{"on":"tile","map":"altar.whitewood-abbey.cell-1","x":4,"y":3},"facing":"down","props":{"age":25,"household":"altar.whitewood-abbey.h0","purse":3,"favourite":"item/material/herb"},"contents":["altar.whitewood-abbey.folk0.coin0","altar.whitewood-abbey.folk0.coin1","altar.whitewood-abbey.folk0.coin2"],"look":{"body":"woman","parts":{"hair":"hair.wavy","face":"face.stern","hat":"hat.cap","outfit":"outfit.vestment","shoes":"shoes.sandals"},"colors":{"skin":"light","hair":"umber","eyes":"amber","hat.1":"undyed","outfit.1":"charcoal","outfit.2":"madder","shoes.1":"leather"}},"npc":{"role":"priest","schedule":[{"from":22,"to":6,"map":"altar.whitewood-abbey.cell-1","x":2,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"altar.whitewood-abbey.cell-1","x":4,"y":3,"activity":"work"},{"from":12,"to":13,"map":"altar.whitewood-abbey.cell-1","x":6,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitewood-abbey.cell-1","x":4,"y":3,"activity":"work"},{"from":18,"to":22,"map":"altar.whitewood-abbey.cell-1","x":6,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.whitewood-abbey.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewood-abbey.folk0"}},{"id":"altar.whitewood-abbey.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewood-abbey.folk0"}},{"id":"altar.whitewood-abbey.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewood-abbey.folk0"}},{"id":"altar.whitewood-abbey.folk1","type":"actor/person/priest","name":{"en":"Regina Choirrow","zh":"雷吉娜·咏巷"},"place":{"on":"tile","map":"altar.whitewood-abbey.cell-2","x":5,"y":1},"facing":"down","props":{"age":52,"household":"altar.whitewood-abbey.h1","purse":2,"favourite":"item/food/pie"},"contents":["altar.whitewood-abbey.folk1.coin0","altar.whitewood-abbey.folk1.coin1"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.weary","outfit":"outfit.vestment","legs":"legs.hose","shoes":"shoes.buckled"},"colors":{"skin":"light","hair":"steelgrey","eyes":"leaf","outfit.1":"ivory","outfit.2":"indigo","legs.1":"linen","shoes.1":"black"}},"npc":{"role":"priest","schedule":[{"from":21,"to":6,"map":"altar.whitewood-abbey.cell-2","x":1,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"altar.whitewood-abbey.cell-2","x":5,"y":1,"activity":"work"},{"from":12,"to":13,"map":"altar.whitewood-abbey.cell-2","x":8,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitewood-abbey.cell-2","x":5,"y":1,"activity":"work"},{"from":18,"to":21,"map":"altar.whitewood-abbey","x":16,"y":29,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitewood-abbey.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewood-abbey.folk1"}},{"id":"altar.whitewood-abbey.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewood-abbey.folk1"}}]}