2"],"look":{"body":"woman","parts":{"hair":"hair.long","face":"face.keen","outfit":"outfit.oilcloth","shoes":"shoes.buckled"},"colors":{"skin":"warm","hair":"umber","eyes":"amber","outfit.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"fisher","schedule":[{"from":21,"to":7,"map":"palefen.wanwick-camp.tent-4","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.wanwick-camp","x":18,"y":15,"activity":"work"},{"from":12,"to":13,"map":"palefen.wanwick-camp.tent-4","x":3,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.wanwick-camp","x":18,"y":15,"activity":"work"},{"from":18,"to":21,"map":"palefen.wanwick-camp.tent-4","x":3,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"weather:rain","text":{"en":"Fish come up in the rain, so I'll stay out a while longer. If you don't mind getting wet, you can watch.","zh":"下雨天鱼爱往上浮，我得多待一会儿。你不怕淋的话，就在边上看着吧。"}},{"key":"default","text":{"en":"The fish have all gone down deep lately. Two all morning, that's all. It wasn't like this in my father's day.","zh":"这阵子鱼都沉到深水里去了，一上午就钓上来两条。我爹那时候可不是这样。"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"type":"item/food/fish/raw","id":"palefen.wanwick-camp.folk3.s0.0","place":{"on":"inside","holder":"palefen.wanwick-camp.folk3"}},{"type":"item/food/fish/raw","id":"palefen.wanwick-camp.folk3.s0.1","place":{"on":"inside","holder":"palefen.wanwick-camp.folk3"}},{"type":"item/food/fish/raw","id":"palefen.wanwick-camp.folk3.s0.2","place":{"on":"inside","holder":"palefen.wanwick-camp.folk3"}},{"type":"item/misc/bait","id":"palefen.wanwick-camp.folk3.s1.0","place":{"on":"inside","holder":"palefen.wanwick-camp.folk3"}},{"type":"item/misc/bait","