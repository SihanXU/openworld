"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.wanwick-camp","x":7,"y":19,"activity":"work"},{"from":12,"to":13,"map":"palefen.wanwick-camp.tent-1","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.wanwick-camp","x":7,"y":19,"activity":"work"},{"from":18,"to":22,"map":"palefen.wanwick-camp","x":24,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Feverfew for headaches, yarrow to stop bleeding. Both are slow to come up this year; I have to go deeper into the woods to gather enough.","zh":"小白菊治头疼，蓍草止血。这两样今年都长得慢，我得往林子深处走才采得够。"}},{"key":"default","text":{"en":"We haven't seen the sun for days. Noon looks much like evening here, and washing won't dry in a week.","zh":"这里好几天没见着太阳了，晌午跟傍晚差不多。晾的衣服一个礼拜都不干。"}}]}}},{"type":"item/material/herb","id":"palefen.wanwick-camp.folk0.s0.0","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/material/herb","id":"palefen.wanwick-camp.folk0.s0.1","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/material/herb","id":"palefen.wanwick-camp.folk0.s0.2","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/material/herb","id":"palefen.wanwick-camp.folk0.s0.3","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/food/berries","id":"palefen.wanwick-camp.folk0.s1.0","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/food/berries","id":"palefen.wanwick-camp.folk0.s1.1","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/food/berries","id":"palefen.wanwick-camp.folk0.s1.2","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},{"type":"item/food/berries","id":"palefen.wanwick-camp.folk0.s1.3","place":{"on":"inside","holder":"palefen.wanwick-camp.folk0"}},