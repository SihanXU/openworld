light":"outdoor","zone":"peaceful","site":{"map":"overworld","x":8,"y":5,"size":1},"edgesWhen":"world.part2"},"entities":[{"id":"waystation~5","type":"fixture/sign/noticeboard","place":{"on":"tile","map":"waystation","x":14,"y":11},"name":{"en":"The Holy See's notice","zh":"圣座告示"},"props":{"text":"BY THE HOLY SEE OF THE FIVE. The Seal-bearers, saints who bear what Astra bore, can bear it no longer. Pilgrims of the Five: seek out the five Seal-bearers, overcome them, and bring the five instruments home to the Holy City for the Great Rite. Before you go on, take the oath at the five wounds.","text_zh":"五苦圣座谕告。持印诸圣代初殉者阿斯特拉承受其苦，今已力竭，难以为继。凡五苦之朝圣者，当寻访五位持印者，胜之，取回五件圣刑之器，奉还圣城，以行五苦大礼。启程之前，须于五道圣伤前立誓。"}},{"id":"waystation~6","type":"fixture/sign","place":{"on":"tile","map":"waystation","x":32,"y":10},"props":{"text":"THE PILGRIM'S ROAD →  Five wayside shrines along it, one for each suffering. Light each as you pass.","text_zh":"朝圣者之路 →　沿路有五座圣龛，一苦一座。路过时请逐一点亮。"}},{"id":"waystation~1","type":"fixture/water/well","place":{"on":"tile","map":"waystation","x":19,"y":19}},{"id":"waystation~2","type":"fixture/light/campfire","place":{"on":"tile","map":"waystation","x":12,"y":19},"statuses":{"lit":-1}},{"id":"waystation~3","type":"fixture/furniture/bench/log","place":{"on":"tile","map":"waystation","x":10,"y":20}},{"id":"waystation~4","type":"fixture/furniture/bench/log","place":{"on":"tile","map":"waystation","x":14,"y":20}},{"id":"waystation~7","type":"fixture/nature/flowers","place":{"on":"tile","map":"waystation","x":5,"y":22}},{"id":"waystation~8","type":"fixture/nature/leaves","place":{"on":"tile","map":"waystation","x":14,"y":3}},{"id":"waystation~9","type":"fixture/nature/leaves","place":{"on":"tile","map":"waystation","x":4,"y":4}},{"id":"waystation~a","type":"fixture/nature/leaves","place":{"on":"tile","map":"waystation","x":4,"y":8}}]}