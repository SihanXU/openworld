ing","text":{"en":"Morning prayers are just over. If you want holy water, you will have to wait for the deacon; he has the key.","zh":"晨祷刚做完。你若要领圣水，得等执事回来，钥匙在他身上。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"type":"item/light/candle","id":"holy.gracemoor-shrine.folk0.s0.0","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"type":"item/light/candle","id":"holy.gracemoor-shrine.folk0.s0.1","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"type":"item/light/candle","id":"holy.gracemoor-shrine.folk0.s0.2","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"type":"item/vessel/flask/holy_water","id":"holy.gracemoor-shrine.folk0.s1.0","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"id":"holy.gracemoor-shrine.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"id":"holy.gracemoor-shrine.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk0"}},{"id":"holy.gracemoor-shrine.folk1","type":"actor/person/traveler","name":{"en":"Celestine Goldford","zh":"塞莱斯廷·金渡"},"place":{"on":"tile","map":"holy.gracemoor-shrine","x":21,"y":9},"facing":"down","props":{"age":48,"household":"holy.gracemoor-shrine.h0","purse":3,"favourite":"item/material/salt"},"contents":["holy.gracemoor-shrine.folk1.coin0","holy.gracemoor-shrine.folk1.coin1","holy.gracemoor-shrine.folk1.coin2"],"look":{"body":"woman","parts":{"hair":"hair.long","face":"face.stern","outfit":"outfit.travel","legs":"legs.stockings","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"umber","eyes":"storm","outfit.1":"russet","legs.1":"charcoal","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":5,"map":"holy.gracemoor-shrine","x":13,"y":12,"activity":"sleep"},{"from":5,"to":12,"map":"holy.gracemoor-shrine","x":21,"y":9,"activity":"work"},{"from":12,"to":13,"map":"holy.gracemoor-shrine","x":13,"y":12,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracemoor-shrine","x":21,"y":9,"activity":"work"},{"from":18,"to":21,"map":"holy.gracemoor-shrine","x":14,"y":21,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.gracemoor-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk1"}},{"id":"holy.gracemoor-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk1"}},{"id":"holy.gracemoor-shrine.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracemoor-shrine.folk1"}}]}