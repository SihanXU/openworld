:"work"},{"from":18,"to":21,"map":"redmarch.warwood-camp","x":21,"y":11,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Drill before dawn, and after drill we dig ditches. The blisters on my hands never get the chance to heal.","zh":"天不亮就操练，练完了还得去挖壕沟。我这手上的泡就没消过。"}},{"key":"default","text":{"en":"Half the company was sent off again last month to escort pilgrims, they said. The rest of us stand two posts each.","zh":"上个月又调走了半个队，说是去护送朝圣的人。剩下我们几个，一人守两个岗。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.warwood-camp.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk3"}},{"id":"redmarch.warwood-camp.folk3.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk3"}},{"id":"redmarch.warwood-camp.folk3.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk3"}},{"id":"redmarch.warwood-camp.folk3.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk3"}},{"id":"redmarch.warwood-camp.folk4","type":"actor/person/traveler","name":{"en":"Jaromir Hawkhill","zh":"雅罗米尔·鹰丘"},"place":{"on":"tile","map":"redmarch.warwood-camp","x":13,"y":8},"facing":"down","props":{"age":33,"household":"redmarch.warwood-camp.h3","purse":4,"favourite":"item/material/salt"},"contents":["redmarch.warwood-camp.folk4.coin0","redmarch.warwood-camp.folk4.coin1","redmarch.warwood-camp.folk4.coin2","redmarch.warwood-camp.folk4.coin3"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.keen","outfit":"outfit.tunic","shoes":"shoes.boots"},"colors":{"skin":"brown","hair":"umber","eyes"