long","face":"face.bright","outfit":"outfit.travel","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"auburn","eyes":"storm","outfit.1":"umber","legs.1":"slate","shoes.1":"leather"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"redmarch.warwood-camp.tent-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.warwood-camp","x":6,"y":6,"activity":"work"},{"from":12,"to":13,"map":"redmarch.warwood-camp.tent-1","x":4,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.warwood-camp","x":6,"y":6,"activity":"work"},{"from":18,"to":22,"map":"redmarch.warwood-camp","x":8,"y":16,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.warwood-camp.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk0"}},{"id":"redmarch.warwood-camp.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk0"}},{"id":"redmarch.warwood-camp.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk0"}},{"id":"redmarch.warwood-camp.folk1","type":"actor/person/soldier","name":{"en":"Vesna Cragwood","zh":"韦斯娜·崖林"},"place":{"on":"tile","map":"redmarch.warwood-camp","x":11,"y":12},"facing":"down","props":{"age":41,"household":"redmarch.warwood-camp.h1","purse":4,"favourite":"item/material/feather","fights":true},"contents":["redmarch.warwood-camp.folk1.coin0","redmarch.warwood-camp.folk1.coin1","redmarch.warwood-camp.folk1.coin2","redmarch.warwood-camp.folk1.coin3"],"look":{"body":"woman","parts":{"hair":"hair.messy","face":"face.soft","hat":"hat.helm","outfit":"outfit.dress","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"black","eyes":"amber","hat.1":"steel","outfit.1":"teal","outfit.2":"linen","shoes.1":"darkleather"}},"npc":{"role":"soldier","schedule":[{"from":21,"to":6,"map":"redmarch.warwood-camp.tent-2","x":2,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.warwood-camp","x":11,"y":12,"activity":"work"},{"from":12,"to":13,"map":"redmarch.warwood-camp.tent-2","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.warwood-camp","x":11,"y":12,"activity":"work"},{"from":18,"to":21,"map":"redmarch.warwood-camp","x":19,"y":18,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Half the company was sent off again last month to escort pilgrims, they said. The rest of us stand two posts each.","zh":"上个月又调走了半个队，说是去护送朝圣的人。剩下我们几个，一人守两个岗。"}},{"key":"default","text":{"en":"Drill before dawn, and after drill we dig ditches. The blisters on my hands never get the chance to heal.","zh":"天不亮就操练，练完了还得去挖壕沟。我这手上的泡就没消过。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.warwood-camp.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk1"}},{"id":"redmarch.warwood-camp.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk1"}},{"id":"redmarch.warwood-camp.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.warwood-camp.folk1"}},{"id":"redmarch.warwood-camp.folk1.coin3","type":"item/misc/thornmark","