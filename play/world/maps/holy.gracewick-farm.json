o":12,"map":"holy.gracewick-farm","x":27,"y":6,"activity":"work"},{"from":12,"to":13,"map":"holy.gracewick-farm.farmhouse-1","x":4,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracewick-farm","x":27,"y":6,"activity":"work"},{"from":18,"to":22,"map":"holy.gracewick-farm.farmhouse-1","x":4,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.gracewick-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk0"}},{"id":"holy.gracewick-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk0"}},{"id":"holy.gracewick-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk0"}},{"id":"holy.gracewick-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk0"}},{"id":"holy.gracewick-farm.folk1","type":"actor/person/elder","name":{"en":"Junia Myrrhhill","zh":"尤尼娅·没药丘"},"place":{"on":"tile","map":"holy.gracewick-farm","x":15,"y":8},"facing":"down","props":{"age":62,"household":"holy.gracewick-farm.h0","purse":5,"favourite":"item/light/candle"},"contents":["holy.gracewick-farm.folk1.coin0","holy.gracewick-farm.folk1.coin1","holy.gracewick-farm.folk1.coin2","holy.gracewick-farm.folk1.coin3","holy.gracewick-farm.folk1.coin4"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.weary","age":"age.lined","outfit":"outfit.shawl","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"snow","eyes":"bark","outfit.1":"umber","outfit.2":"steelgrey","shoes.1":"darkleather"}},"npc":{"role":"elder","schedule":[{"from":21,"to":6,"map":"holy.gracewick-farm.farmhouse-1","x":2,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"holy.gracewick-farm","x":15,"y":8,"activity":"sit"},{"from":12,"to":13,"map":"holy.gracewick-farm.farmhouse-1","x":6,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracewick-farm","x":15,"y":8,"activity":"sit"},{"from":18,"to":21,"map":"holy.gracewick-farm.farmhouse-1","x":6,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.gracewick-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk1"}},{"id":"holy.gracewick-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk1"}},{"id":"holy.gracewick-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk1"}},{"id":"holy.gracewick-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk1"}},{"id":"holy.gracewick-farm.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk1"}},{"id":"holy.gracewick-farm.folk2","type":"actor/person/child","name":{"en":"Valeria Myrrhhill","zh":"瓦莱丽娅·没药丘"},"place":{"on":"tile","map":"holy.gracewick-farm.farmhouse-1","x":1,"y":2},"facing":"down","props":{"age":7,"household":"holy.gracewick-farm.h0","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["holy.gracewick-farm.folk2.coin0"],"look":{"body":"girl","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.smock","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"chestnut","eyes":"leaf","outfit.1":"umber","shoes.1":"black"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.gracewick-farm.farmhouse-1","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.gracewick-farm","x":13,"y":12,"activity":"play"},{"from":12,"to":13,"map":"holy.gracewick-farm.farmhouse-1","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracewick-farm","x":13,"y":12,"activity":"play"},{"from":18,"to":20,"map":"holy.gracewick-farm.farmhouse-1","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.gracewick-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk2"}},{"id":"holy.gracewick-farm.folk3","type":"actor/person/child","name":{"en":"Marcus Myrrhhill","zh":"马库斯·没药丘"},"place":{"on":"tile","map":"holy.gracewick-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":14,"household":"holy.gracewick-farm.h0","purse":1,"favourite":"item/vessel/flask/holy_water"},"tags":["minor"],"contents":["holy.gracewick-farm.folk3.coin0"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.bright","outfit":"outfit.workshirt","legs":"legs.hose","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"honey","eyes":"sky","outfit.1":"linen","outfit.2":"slate","legs.1":"moss","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.gracewick-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.gracewick-farm.farmhouse-1","x":9,"y":4,"activity":"play"},{"from":12,"to":13,"map":"holy.gracewick-farm.farmhouse-1","x":7,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.gracewick-farm.farmhouse-1","x":9,"y":4,"activity":"play"},{"from":18,"to":20,"map":"holy.gracewick-farm.farmhouse-1","x":7,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.gracewick-farm.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.gracewick-farm.folk3"}}]}