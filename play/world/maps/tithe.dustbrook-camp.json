ustbrook-camp.tent-2","x":3,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I'm packing up. Buy now if you want anything; I'm off early tomorrow to restock.","zh":"我要收摊了。要买趁现在，明天我得一早去进货。"}},{"key":"default","text":{"en":"Salt has gone up again; it costs me a third more to buy in than last month. I can't help it. If it's too dear, buy less.","zh":"盐又涨了，进价比上个月高了三成。我也没办法，你要是嫌贵，就少买点。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"type":"item/food/bread","id":"tithe.dustbrook-camp.folk1.s0.0","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/food/bread","id":"tithe.dustbrook-camp.folk1.s0.1","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/food/bread","id":"tithe.dustbrook-camp.folk1.s0.2","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/light/candle","id":"tithe.dustbrook-camp.folk1.s1.0","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/light/candle","id":"tithe.dustbrook-camp.folk1.s1.1","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/light/candle","id":"tithe.dustbrook-camp.folk1.s1.2","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/light/candle","id":"tithe.dustbrook-camp.folk1.s1.3","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/material/cloth","id":"tithe.dustbrook-camp.folk1.s2.0","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/material/cloth","id":"tithe.dustbrook-camp.folk1.s2.1","place":{"on":"inside","holder":"tithe.dustbrook-camp.folk1"}},{"type":"item/light/torch","id":"tithe.dustbrook-camp.folk1.s3.0","place":{"on":"insid