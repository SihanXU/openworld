:25}},{"id":"holy.halocombe-farm~w","type":"fixture/nature/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":24,"y":25}},{"id":"holy.halocombe-farm~x","type":"fixture/light/lamppost","place":{"on":"tile","map":"holy.halocombe-farm","x":10,"y":14}},{"id":"holy.halocombe-farm~y","type":"fixture/furniture/cart/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":16,"y":9}},{"id":"holy.halocombe-farm~z","type":"fixture/furniture/cart/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":35,"y":16}},{"id":"holy.halocombe-farm~10","type":"fixture/furniture/cart/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":31,"y":20}},{"id":"holy.halocombe-farm~11","type":"fixture/furniture/cart/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":8,"y":25}},{"id":"holy.halocombe-farm~12","type":"fixture/furniture/cart/flowers","place":{"on":"tile","map":"holy.halocombe-farm","x":28,"y":25}},{"id":"holy.halocombe-farm.folk0","type":"actor/person/farmer","name":{"en":"Octavia Graceman","zh":"屋大薇·恩人"},"place":{"on":"tile","map":"holy.halocombe-farm.farmhouse-1","x":2,"y":1},"facing":"down","props":{"age":32,"household":"holy.halocombe-farm.h0","purse":3,"favourite":"item/misc/lute"},"contents":["holy.halocombe-farm.folk0.coin0","holy.halocombe-farm.folk0.coin1","holy.halocombe-farm.folk0.coin2"],"look":{"body":"woman","parts":{"hair":"hair.messy","face":"face.keen","outfit":"outfit.workdress","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"fair","hair":"chestnut","eyes":"leaf","outfit.1":"linen","outfit.2":"linen","legs.1":"linen","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"holy.halocombe-farm.farmhouse-1","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.halocombe-farm","x":24,"y":9,"activity":"work"},{"from":12,"to":13,"map":"holy.halocombe-farm.farmhouse-1","x":5,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.halocombe-farm","x":24,"y":9,"activity":"work"},{"from":18,"to":22,"map":"holy.halocombe-farm","x":23,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.halocombe-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk0"}},{"id":"holy.halocombe-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk0"}},{"id":"holy.halocombe-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk0"}},{"id":"holy.halocombe-farm.folk1","type":"actor/person/elder","name":{"en":"Valens Graceman","zh":"瓦伦斯·恩人"},"place":{"on":"tile","map":"holy.halocombe-farm.farmhouse-1","x":4,"y":4},"facing":"down","props":{"age":67,"household":"holy.halocombe-farm.h0","purse":4,"favourite":"item/material/salt"},"contents":["holy.halocombe-farm.folk1.coin0","holy.halocombe-farm.folk1.coin1","holy.halocombe-farm.folk1.coin2","holy.halocombe-farm.folk1.coin3"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.weary","beard":"beard.stubble","age":"age.lined","outfit":"outfit.workshirt","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"snow","eyes":"storm","outfit.1":"ochre","outfit.2":"slate","shoes.1":"black"}},"npc":{"role":"elder","schedule":[{"from":22,"to":6,"map":"holy.halocombe-farm.farmhouse-1","x":6,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"holy.halocombe-farm.farmhouse-1","x":4,"y":4,"activity":"sit"},{"from":12,"to":13,"map":"holy.halocombe-farm.farmhouse-1","x":6,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.halocombe-farm.farmhouse-1","x":4,"y":4,"activity":"sit"},{"from":18,"to":22,"map":"holy.halocombe-farm","x":36,"y":16,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.halocombe-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk1"}},{"id":"holy.halocombe-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk1"}},{"id":"holy.halocombe-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk1"}},{"id":"holy.halocombe-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk1"}},{"id":"holy.halocombe-farm.folk2","type":"actor/person/elder","name":{"en":"Seraphina Graceman","zh":"塞拉菲娜·恩人"},"place":{"on":"tile","map":"holy.halocombe-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":70,"household":"holy.halocombe-farm.h0","purse":5,"favourite":"item/food/fish/cooked"},"contents":["holy.halocombe-farm.folk2.coin0","holy.halocombe-farm.folk2.coin1","holy.halocombe-farm.folk2.coin2","holy.halocombe-farm.folk2.coin3","holy.halocombe-farm.folk2.coin4"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.keen","age":"age.lined","outfit":"outfit.dress","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"steelgrey","eyes":"amber","outfit.1":"rose","outfit.2":"linen","legs.1":"moss","shoes.1":"darkleather"}},"npc":{"role":"elder","schedule":[{"from":21,"to":7,"map":"holy.halocombe-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.halocombe-farm","x":5,"y":14,"activity":"sit"},{"from":12,"to":13,"map":"holy.halocombe-farm.farmhouse-1","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.halocombe-farm","x":5,"y":14,"activity":"sit"},{"from":18,"to":21,"map":"holy.halocombe-farm","x":13,"y":14,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.halocombe-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk2"}},{"id":"holy.halocombe-farm.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk2"}},{"id":"holy.halocombe-farm.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk2"}},{"id":"holy.halocombe-farm.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk2"}},{"id":"holy.halocombe-farm.folk2.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.halocombe-farm.folk2"}}]}