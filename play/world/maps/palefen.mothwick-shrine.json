:4,"y":20}},{"id":"palefen.mothwick-shrine~9","type":"fixture/sacred/statue","place":{"on":"tile","map":"palefen.mothwick-shrine","x":15,"y":9}},{"id":"palefen.mothwick-shrine~a","type":"fixture/light/candles","place":{"on":"tile","map":"palefen.mothwick-shrine","x":13,"y":10}},{"id":"palefen.mothwick-shrine~b","type":"fixture/light/candles","place":{"on":"tile","map":"palefen.mothwick-shrine","x":17,"y":10}},{"id":"palefen.mothwick-shrine~c","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.mothwick-shrine","x":19,"y":9}},{"id":"palefen.mothwick-shrine~d","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.mothwick-shrine","x":12,"y":12}},{"id":"palefen.mothwick-shrine.folk0","type":"actor/person/priest","name":{"en":"Lorcan Mirehill","zh":"洛肯·泥丘"},"place":{"on":"tile","map":"palefen.mothwick-shrine","x":18,"y":14},"facing":"down","props":{"age":26,"household":"palefen.mothwick-shrine.h0","purse":2,"favourite":"item/material/fireweed","stock":"item/light/candle*3|item/vessel/flask/holy_water*1"},"tags":["merchant"],"contents":["palefen.mothwick-shrine.folk0.s0.0","palefen.mothwick-shrine.folk0.s0.1","palefen.mothwick-shrine.folk0.s0.2","palefen.mothwick-shrine.folk0.s1.0","palefen.mothwick-shrine.folk0.coin0","palefen.mothwick-shrine.folk0.coin1"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.keen","outfit":"outfit.workshirt","legs":"legs.wraps","shoes":"shoes.sandals"},"colors":{"skin":"light","hair":"chestnut","eyes":"bark","outfit.1":"ochre","outfit.2":"umber","legs.1":"umber","shoes.1":"leather"}},"npc":{"role":"priest","schedule":[{"from":22,"to":7,"map":"palefen.mothwick-shrine","x":18,"y":14,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.mothwick-shrine","x":18,"y":7,"activity":"work"},{"from":12,"to":13,"map":"palefen.mothwick-shrine","x":18,"y":14,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.mothwick-shrine","x":18,"y":7,"activity":"work"},{"from":18,"to":22,"map":"palefen.mothwick-shrine","x":14,"y":7,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"hour:morning","text":{"en":"Morning prayers are just over. If you want holy water, you will have to wait for the deacon; he has the key.","zh":"晨祷刚做完。你若要领圣水，得等执事回来，钥匙在他身上。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"type":"item/light/candle","id":"palefen.mothwick-shrine.folk0.s0.0","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.mothwick-shrine.folk0.s0.1","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.mothwick-shrine.folk0.s0.2","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"type":"item/vessel/flask/holy_water","id":"palefen.mothwick-shrine.folk0.s1.0","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"id":"palefen.mothwick-shrine.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"id":"palefen.mothwick-shrine.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk0"}},{"id":"palefen.mothwick-shrine.folk1","type":"actor/person/traveler","name":{"en":"Fintan Mirehill","zh":"芬坦·泥丘"},"place":{"on":"tile","map":"palefen.mothwick-shrine","x":13,"y":14},"facing":"down","props":{"age":20,"household":"palefen.mothwick-shrine.h0","purse":3,"favourite":"item/food/ale"},"contents":["palefen.mothwick-shrine.folk1.coin0","palefen.mothwick-shrine.folk1.coin1","palefen.mothwick-shrine.folk1.coin2"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.bright","beard":"beard.stubble","outfit":"outfit.cloak"},"colors":{"skin":"deep","hair":"umber","eyes":"sky","outfit.1":"forest"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"palefen.mothwick-shrine","x":13,"y":14,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.mothwick-shrine","x":14,"y":6,"activity":"work"},{"from":12,"to":13,"map":"palefen.mothwick-shrine","x":13,"y":14,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.mothwick-shrine","x":14,"y":6,"activity":"work"},{"from":18,"to":22,"map":"palefen.mothwick-shrine","x":19,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"id":"palefen.mothwick-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk1"}},{"id":"palefen.mothwick-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk1"}},{"id":"palefen.mothwick-shrine.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk1"}},{"id":"palefen.mothwick-shrine.folk2","type":"actor/person/traveler","name":{"en":"Cormac Mirehill","zh":"科马克·泥丘"},"place":{"on":"tile","map":"palefen.mothwick-shrine","x":12,"y":5},"facing":"down","props":{"age":31,"household":"palefen.mothwick-shrine.h0","purse":2,"favourite":"item/food/fish/cooked"},"contents":["palefen.mothwick-shrine.folk2.coin0","palefen.mothwick-shrine.folk2.coin1"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.stern","beard":"beard.moustache","hat":"hat.hood","outfit":"outfit.tunic","shoes":"shoes.boots"},"colors":{"skin":"tan","hair":"gold","eyes":"bark","hat.1":"umber","outfit.1":"ivory","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":6,"map":"palefen.mothwick-shrine","x":17,"y":8,"activity":"sleep"},{"from":6,"to":12,"map":"palefen.mothwick-shrine","x":12,"y":5,"activity":"work"},{"from":12,"to":13,"map":"palefen.mothwick-shrine","x":17,"y":8,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.mothwick-shrine","x":12,"y":5,"activity":"work"},{"from":18,"to":22,"map":"palefen.mothwick-shrine","x":19,"y":10,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"We haven't seen the sun for days. Noon looks much like evening here, and washing won't dry in a week.","zh":"这里好几天没见着太阳了，晌午跟傍晚差不多。晾的衣服一个礼拜都不干。"}}]}}},{"id":"palefen.mothwick-shrine.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk2"}},{"id":"palefen.mothwick-shrine.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.mothwick-shrine.folk2"}}]}