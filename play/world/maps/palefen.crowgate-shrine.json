,"x":15,"y":9}},{"id":"palefen.crowgate-shrine~8","type":"fixture/light/candles","place":{"on":"tile","map":"palefen.crowgate-shrine","x":13,"y":10}},{"id":"palefen.crowgate-shrine~9","type":"fixture/light/candles","place":{"on":"tile","map":"palefen.crowgate-shrine","x":17,"y":10}},{"id":"palefen.crowgate-shrine~a","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.crowgate-shrine","x":11,"y":6}},{"id":"palefen.crowgate-shrine~b","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.crowgate-shrine","x":11,"y":7}},{"id":"palefen.crowgate-shrine~c","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.crowgate-shrine","x":18,"y":12}},{"id":"palefen.crowgate-shrine~d","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.crowgate-shrine","x":12,"y":13}},{"id":"palefen.crowgate-shrine.folk0","type":"actor/person/priest","name":{"en":"Moira Stillhold","zh":"莫伊拉·寂堡"},"place":{"on":"tile","map":"palefen.crowgate-shrine","x":17,"y":7},"facing":"down","props":{"age":26,"household":"palefen.crowgate-shrine.h0","purse":5,"favourite":"item/food/fish/catfish","stock":"item/light/candle*3|item/vessel/flask/holy_water*1"},"tags":["merchant"],"contents":["palefen.crowgate-shrine.folk0.s0.0","palefen.crowgate-shrine.folk0.s0.1","palefen.crowgate-shrine.folk0.s0.2","palefen.crowgate-shrine.folk0.s1.0","palefen.crowgate-shrine.folk0.coin0","palefen.crowgate-shrine.folk0.coin1","palefen.crowgate-shrine.folk0.coin2","palefen.crowgate-shrine.folk0.coin3","palefen.crowgate-shrine.folk0.coin4"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.keen","mark":"mark.freckles","outfit":"outfit.vestment","shoes":"shoes.sandals"},"colors":{"skin":"deep","hair":"auburn","eyes":"amber","outfit.1":"snow","outfit.2":"madder","shoes.1":"umber"}},"npc":{"role":"priest","schedule":[{"from":22,"to":6,"map":"palefen.crowgate-shrine","x":15,"y":15,"activity":"sleep"},{"from":6,"to":12,"map":"palefen.crowgate-shrine","x":17,"y":7,"activity":"work"},{"from":12,"to":13,"map":"palefen.crowgate-shrine","x":15,"y":15,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.crowgate-shrine","x":17,"y":7,"activity":"work"},{"from":18,"to":22,"map":"palefen.crowgate-shrine","x":15,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"type":"item/light/candle","id":"palefen.crowgate-shrine.folk0.s0.0","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.crowgate-shrine.folk0.s0.1","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.crowgate-shrine.folk0.s0.2","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"type":"item/vessel/flask/holy_water","id":"palefen.crowgate-shrine.folk0.s1.0","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk0.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk0"}},{"id":"palefen.crowgate-shrine.folk1","type":"actor/person/traveler","name":{"en":"Ronan Stillhold","zh":"罗南·寂堡"},"place":{"on":"tile","map":"palefen.crowgate-shrine","x":16,"y":11},"facing":"down","props":{"age":47,"household":"palefen.crowgate-shrine.h0","purse":5,"favourite":"item/food/fish/sunfish"},"contents":["palefen.crowgate-shrine.folk1.coin0","palefen.crowgate-shrine.folk1.coin1","palefen.crowgate-shrine.folk1.coin2","palefen.crowgate-shrine.folk1.coin3","palefen.crowgate-shrine.folk1.coin4"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","outfit":"outfit.travel","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"umber","eyes":"leaf","outfit.1":"russet","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"palefen.crowgate-shrine","x":16,"y":11,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.crowgate-shrine","x":14,"y":8,"activity":"work"},{"from":12,"to":13,"map":"palefen.crowgate-shrine","x":16,"y":11,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.crowgate-shrine","x":14,"y":8,"activity":"work"},{"from":18,"to":22,"map":"palefen.crowgate-shrine","x":16,"y":11,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"id":"palefen.crowgate-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk1"}},{"id":"palefen.crowgate-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk1"}},{"id":"palefen.crowgate-shrine.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk1"}},{"id":"palefen.crowgate-shrine.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk1"}},{"id":"palefen.crowgate-shrine.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk1"}},{"id":"palefen.crowgate-shrine.folk2","type":"actor/person/traveler","name":{"en":"Isla Stillhold","zh":"艾拉·寂堡"},"place":{"on":"tile","map":"palefen.crowgate-shrine","x":11,"y":15},"facing":"down","props":{"age":42,"household":"palefen.crowgate-shrine.h0","purse":2,"favourite":"item/food/apple"},"contents":["palefen.crowgate-shrine.folk2.coin0","palefen.crowgate-shrine.folk2.coin1"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.stern","outfit":"outfit.cloak","legs":"legs.stockings","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"black","eyes":"amber","outfit.1":"umber","legs.1":"indigo","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"palefen.crowgate-shrine","x":11,"y":15,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.crowgate-shrine","x":11,"y":12,"activity":"work"},{"from":12,"to":13,"map":"palefen.crowgate-shrine","x":11,"y":15,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.crowgate-shrine","x":11,"y":12,"activity":"work"},{"from":18,"to":22,"map":"palefen.crowgate-shrine","x":11,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"We haven't seen the sun for days. Noon looks much like evening here, and washing won't dry in a week.","zh":"这里好几天没见着太阳了，晌午跟傍晚差不多。晾的衣服一个礼拜都不干。"}}]}}},{"id":"palefen.crowgate-shrine.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk2"}},{"id":"palefen.crowgate-shrine.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.crowgate-shrine.folk2"}}]}