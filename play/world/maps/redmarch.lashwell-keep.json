"}},{"id":"redmarch.lashwell-keep.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk0"}},{"id":"redmarch.lashwell-keep.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk0"}},{"id":"redmarch.lashwell-keep.folk1","type":"actor/person/soldier","name":{"en":"Branka Ironford","zh":"布兰卡·铁渡"},"place":{"on":"tile","map":"redmarch.lashwell-keep","x":29,"y":6},"facing":"down","props":{"age":27,"household":"redmarch.lashwell-keep.h0","purse":4,"favourite":"item/food/fish/perch","fights":true},"contents":["redmarch.lashwell-keep.folk1.coin0","redmarch.lashwell-keep.folk1.coin1","redmarch.lashwell-keep.folk1.coin2","redmarch.lashwell-keep.folk1.coin3"],"look":{"body":"woman","parts":{"hair":"hair.messy","face":"face.bright","hat":"hat.helm","outfit":"outfit.dress","shoes":"shoes.tall"},"colors":{"skin":"fair","hair":"black","eyes":"hazel","hat.1":"steel","outfit.1":"slate","outfit.2":"ivory","shoes.1":"leather"}},"npc":{"role":"soldier","schedule":[{"from":22,"to":5,"map":"redmarch.lashwell-keep.barracks-1","x":4,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.lashwell-keep","x":29,"y":6,"activity":"work"},{"from":12,"to":13,"map":"redmarch.lashwell-keep.barracks-1","x":2,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.lashwell-keep","x":29,"y":6,"activity":"work"},{"from":18,"to":22,"map":"redmarch.lashwell-keep.barracks-1","x":2,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Drill before dawn, and after drill we dig ditches. The blisters on my hands never get the chance to heal.","zh":"天不亮就操练，练完了还得去挖壕沟。我这手上的泡就没消过。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.lashwell-keep.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk1"}},{"id":"redmarch.lashwell-keep.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk1"}},{"id":"redmarch.lashwell-keep.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk1"}},{"id":"redmarch.lashwell-keep.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.lashwell-keep.folk1"}},{"id":"redmarch.lashwell-keep.folk2","type":"actor/person/soldier","name":{"en":"Dietmar Ironford","zh":"迪特马尔·铁渡"},"place":{"on":"tile","map":"redmarch.lashwell-keep.barracks-1","x":3,"y":1},"facing":"down","props":{"age":20,"household":"redmarch.lashwell-keep.h0","purse":3,"favourite":"item/misc/bell","fights":true},"contents":["redmarch.lashwell-keep.folk2.coin0","redmarch.lashwell-keep.folk2.coin1","redmarch.lashwell-keep.folk2.coin2"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.keen","hat":"hat.cap","outfit":"outfit.gambeson","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"chestnut","eyes":"sky","hat.1":"moss","outfit.1":"woad","shoes.1":"darkleather"}},"npc":{"role":"soldier","schedule":[{"from":21,"to":7,"map":"redmarch.lashwell-keep.barracks-1","x":3,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.lashwell-keep","x":33,"y":5,"activity":"work"},{"from":12,"to":13,"map":"redmarch.lashwell-keep.barracks-1","x":3,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.lashwell-keep","x":33,"y":5,"activity":"work"},{"from":18,"to":21,"map":"redmarch.lashwell-keep","x":20,"y":30,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Half the company was sent off again last month to e