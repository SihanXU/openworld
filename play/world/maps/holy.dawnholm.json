coin3"],"look":{"body":"woman","parts":{"hair":"hair.long","face":"face.keen","hat":"hat.hood","outfit":"outfit.cloak","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"auburn","eyes":"sky","hat.1":"umber","outfit.1":"slate","shoes.1":"leather"}},"npc":{"role":"hunter","schedule":[{"from":21,"to":5,"map":"holy.dawnholm.home-5","x":4,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"holy.dawnholm","x":4,"y":22,"activity":"work"},{"from":12,"to":13,"map":"holy.dawnholm.home-5","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm","x":4,"y":22,"activity":"work"},{"from":18,"to":21,"map":"holy.dawnholm.home-5","x":4,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"If you go into the woods, keep clear of the spots marked with red rags. Those are my snares.","zh":"你要进林子的话，绕开那些挂了红布条的地方，那是我下的套子。"}},{"key":"default","text":{"en":"Half the deer in the woods are gone, and there are tracks I can't put a name to. Big ones. I'm back before dark now.","zh":"林子里的鹿少了一大半，倒多了些我叫不出名字的脚印，个头不小。我现在都赶在天黑前回来。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.dawnholm.folk8.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk8"}},{"id":"holy.dawnholm.folk8.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk8"}},{"id":"holy.dawnholm.folk8.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk8"}},{"id":"holy.dawnholm.folk8.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk8"}},{"id":"holy.dawnholm.folk9","type":"actor/person/elder","name":{"en":"Ignatius Myrrhcroft","zh":"依纳爵·没药园"},"place":{"on":"tile","map":"holy.dawnholm.home-6","x":7,"y":2},"facing":"down","props":{"age":74,"household":"holy.dawnholm.h5","purse":2,"favourite":"item/misc/doll"},"contents":["holy.dawnholm.folk9.coin0","holy.dawnholm.folk9.coin1"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.stern","age":"age.lined","outfit":"outfit.workshirt","shoes":"shoes.shoes"},"colors":{"skin":"tan","hair":"silver","eyes":"sky","outfit.1":"linen","outfit.2":"umber","shoes.1":"black"}},"npc":{"role":"elder","schedule":[{"from":22,"to":6,"map":"holy.dawnholm.home-6","x":3,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"holy.dawnholm.home-6","x":7,"y":2,"activity":"sit"},{"from":12,"to":13,"map":"holy.dawnholm.home-6","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm.home-6","x":7,"y":2,"activity":"sit"},{"from":18,"to":22,"map":"holy.dawnholm.home-6","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.dawnholm.folk9.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk9"}},{"id":"holy.dawnholm.folk9.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk9"}},{"id":"holy.dawnholm.folk10","type":"actor/person/villager","name":{"en":"Marina Myrrhcroft","zh":"玛丽娜·没药园"},"place":{"on":"tile","map":"holy.dawnholm.home-6","x":4,"y":2},"facing":"down","props":{"age":56,"household":"holy.dawnholm.h5","purse":3,"favourite":"item/material/frostcap"},"contents":["holy.dawnholm.folk10.coin0","holy.dawnholm.folk10.coin1","holy.dawnholm.folk10.coin2"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.keen","age":"age.lined","outfit":"outfit.dress","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"black","eyes":"amber","outfit.1":"plum","outfit.2":"undyed","shoes.1":"leather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":7,"map":"holy.dawnholm.home-6","x":4,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.dawnholm.home-6","x":2,"y":6,"activity":"work"},{"from":12,"to":13,"map":"holy.dawnholm.home-6","x":5,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm.home-6","x":2,"y":6,"activity":"work"},{"from":18,"to":21,"map":"holy.dawnholm","x":23,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"It gets dark earlier every day. Our lamp oil used to last till spring; this year I doubt it will see midwinter.","zh":"天黑得一天比一天早了。我家的灯油往年能点到开春，今年怕是撑不到冬至。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.dawnholm.folk10.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk10"}},{"id":"holy.dawnholm.folk10.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk10"}},{"id":"holy.dawnholm.folk10.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk10"}},{"id":"holy.dawnholm.folk11","type":"actor/person/child","name":{"en":"Flavia Myrrhcroft","zh":"弗拉维娅·没药园"},"place":{"on":"tile","map":"holy.dawnholm.home-6","x":3,"y":2},"facing":"down","props":{"age":9,"household":"holy.dawnholm.h5","purse":1,"favourite":"item/food/apple"},"tags":["minor"],"contents":["holy.dawnholm.folk11.coin0"],"look":{"body":"girl","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.pinafore","legs":"legs.hose","shoes":"shoes.buckled"},"colors":{"skin":"light","hair":"gold","eyes":"bark","outfit.1":"woad","legs.1":"moss","shoes.1":"plum"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.dawnholm.home-6","x":3,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.dawnholm","x":18,"y":17,"activity":"play"},{"from":12,"to":13,"map":"holy.dawnholm.home-6","x":7,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm","x":18,"y":17,"activity":"play"},{"from":18,"to":20,"map":"holy.dawnholm.home-6","x":7,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.dawnholm.folk11.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk11"}},{"id":"holy.dawnholm.folk12","type":"actor/person/child","name":{"en":"Severus Myrrhcroft","zh":"塞维鲁·没药园"},"place":{"on":"tile","map":"holy.dawnholm.home-6","x":4,"y":1},"facing":"down","props":{"age":14,"household":"holy.dawnholm.h5","purse":1,"favourite":"item/food/cheese"},"tags":["minor"],"contents":["holy.dawnholm.folk12.coin0"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.keen","mark":"mark.freckles","hat":"hat.cap","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"brown","hair":"umber","eyes":"hazel","hat.1":"woad","outfit.1":"woad","outfit.2":"moss","shoes.1":"darkleather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.dawnholm.home-6","x":4,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"holy.dawnholm.home-6","x":6,"y":3,"activity":"play"},{"from":12,"to":13,"map":"holy.dawnholm.home-6","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm.home-6","x":6,"y":3,"activity":"play"},{"from":18,"to":20,"map":"holy.dawnholm","x":18,"y":10,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.dawnholm.folk12.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk12"}},{"id":"holy.dawnholm.folk13","type":"actor/person/elder","name":{"en":"Tiberius Lightwell","zh":"提比略·光井"},"place":{"on":"tile","map":"holy.dawnholm.home-7","x":7,"y":6},"facing":"down","props":{"age":66,"household":"holy.dawnholm.h6","purse":3,"favourite":"item/food/ale"},"contents":["holy.dawnholm.folk13.coin0","holy.dawnholm.fo