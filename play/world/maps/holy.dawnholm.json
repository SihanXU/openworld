"props":{"age":35,"household":"holy.dawnholm.h7","purse":3,"favourite":"item/material/herb"},"contents":["holy.dawnholm.folk16.coin0","holy.dawnholm.folk16.coin1","holy.dawnholm.folk16.coin2"],"look":{"body":"man","parts":{"hair":"hair.ponytail","face":"face.stern","beard":"beard.stubble","hat":"hat.cap","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"tan","hair":"umber","eyes":"bark","hat.1":"umber","outfit.1":"linen","outfit.2":"umber","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":7,"map":"holy.dawnholm.home-8","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.dawnholm","x":34,"y":3,"activity":"work"},{"from":12,"to":13,"map":"holy.dawnholm.home-8","x":4,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.dawnholm","x":34,"y":3,"activity":"work"},{"from":18,"to":21,"map":"holy.dawnholm.home-8","x":4,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.dawnholm.folk16.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk16"}},{"id":"holy.dawnholm.folk16.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk16"}},{"id":"holy.dawnholm.folk16.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.dawnholm.folk16"}}]}