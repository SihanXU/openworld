","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.graincrest-camp.tent-1","x":2,"y":3,"activity":"work"},{"from":18,"to":22,"map":"tithe.graincrest-camp","x":8,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I'm packing up. Buy now if you want anything; I'm off early tomorrow to restock.","zh":"我要收摊了。要买趁现在，明天我得一早去进货。"}},{"key":"default","text":{"en":"Salt has gone up again; it costs me a third more to buy in than last month. I can't help it. If it's too dear, buy less.","zh":"盐又涨了，进价比上个月高了三成。我也没办法，你要是嫌贵，就少买点。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"type":"item/food/bread","id":"tithe.graincrest-camp.folk1.s0.0","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/food/bread","id":"tithe.graincrest-camp.folk1.s0.1","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/food/bread","id":"tithe.graincrest-camp.folk1.s0.2","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/light/candle","id":"tithe.graincrest-camp.folk1.s1.0","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/light/candle","id":"tithe.graincrest-camp.folk1.s1.1","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/light/candle","id":"tithe.graincrest-camp.folk1.s1.2","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/light/candle","id":"tithe.graincrest-camp.folk1.s1.3","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"type":"item/material/cloth","id":"tithe.graincrest-camp.folk1.s2.0","place":{"on":"inside","holder":"tithe.graincrest-camp.folk1"}},{"ty