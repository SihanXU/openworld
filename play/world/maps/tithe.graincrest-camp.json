veler","name":{"en":"Agnes Sheafhold","zh":"艾格尼丝·捆堡"},"place":{"on":"tile","map":"tithe.graincrest-camp","x":18,"y":15},"facing":"down","props":{"age":18,"household":"tithe.graincrest-camp.h2","purse":2,"favourite":"item/food/fish/eel"},"contents":["tithe.graincrest-camp.folk3.coin0","tithe.graincrest-camp.folk3.coin1"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.soft","outfit":"outfit.cloak","shoes":"shoes.boots"},"colors":{"skin":"tan","hair":"copper","eyes":"bark","outfit.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":5,"map":"tithe.graincrest-camp.tent-3","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"tithe.graincrest-camp","x":18,"y":15,"activity":"work"},{"from":12,"to":13,"map":"tithe.graincrest-camp.tent-3","x":6,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.graincrest-camp","x":18,"y":15,"activity":"work"},{"from":18,"to":21,"map":"tithe.graincrest-camp.tent-3","x":6,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.graincrest-camp.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.graincrest-camp.folk3"}},{"id":"tithe.graincrest-camp.folk3.coin1","type":"item/misc/thor