ile","map":"redmarch.redfield-farm","x":10,"y":24}},{"id":"redmarch.redfield-farm.folk0","type":"actor/person/farmer","name":{"en":"Zora Irondale","zh":"佐拉·铁谷"},"place":{"on":"tile","map":"redmarch.redfield-farm.farmhouse-1","x":1,"y":1},"facing":"down","props":{"age":52,"household":"redmarch.redfield-farm.h0","purse":3,"favourite":"item/food/egg/boiled"},"contents":["redmarch.redfield-farm.folk0.coin0","redmarch.redfield-farm.folk0.coin1","redmarch.redfield-farm.folk0.coin2"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.keen","hat":"hat.kerchief","outfit":"outfit.workdress","shoes":"shoes.buckled"},"colors":{"skin":"light","hair":"steelgrey","eyes":"sky","hat.1":"moss","outfit.1":"moss","outfit.2":"linen","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"redmarch.redfield-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.redfield-farm","x":16,"y":8,"activity":"work"},{"from":12,"to":13,"map":"redmarch.redfield-farm.farmhouse-1","x":6,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.redfield-farm","x":16,"y":8,"activity":"work"},{"from":18,"to":22,"map":"redmarch.redfield-farm.farmhouse-1","x":6,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.redfield-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk0"}},{"id":"redmarch.redfield-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk0"}},{"id":"redmarch.redfield-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk0"}},{"id":"redmarch.redfield-farm.folk1","type":"actor/person/elder","name":{"en":"Ottokar Irondale","zh":"奥托卡·铁谷"},"place":{"on":"tile","map":"redmarch.redfield-farm.farmhouse-1","x":3,"y":5},"facing":"down","props":{"age":77,"household":"redmarch.redfield-farm.h0","purse":3,"favourite":"item/food/ale"},"contents":["redmarch.redfield-farm.folk1.coin0","redmarch.redfield-farm.folk1.coin1","redmarch.redfield-farm.folk1.coin2"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.keen","beard":"beard.full","age":"age.lined","outfit":"outfit.workshirt","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"snow","eyes":"leaf","outfit.1":"undyed","outfit.2":"umber","legs.1":"moss","shoes.1":"umber"}},"npc":{"role":"elder","schedule":[{"from":22,"to":5,"map":"redmarch.redfield-farm.farmhouse-1","x":5,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.redfield-farm.farmhouse-1","x":3,"y":5,"activity":"sit"},{"from":12,"to":13,"map":"redmarch.redfield-farm.farmhouse-1","x":3,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.redfield-farm.farmhouse-1","x":3,"y":5,"activity":"sit"},{"from":18,"to":22,"map":"redmarch.redfield-farm","x":34,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.redfield-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk1"}},{"id":"redmarch.redfield-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk1"}},{"id":"redmarch.redfield-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.redfield-farm.folk1"}}]}