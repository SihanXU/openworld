]}}},{"id":"altar.lancevale-camp.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk0"}},{"id":"altar.lancevale-camp.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk0"}},{"id":"altar.lancevale-camp.folk1","type":"actor/person/traveler","name":{"en":"Dominic Rosestone","zh":"多明我·玫瑰石"},"place":{"on":"tile","map":"altar.lancevale-camp","x":22,"y":10},"facing":"down","props":{"age":53,"household":"altar.lancevale-camp.h0","purse":6,"favourite":"item/misc/doll"},"contents":["altar.lancevale-camp.folk1.coin0","altar.lancevale-camp.folk1.coin1","altar.lancevale-camp.folk1.coin2","altar.lancevale-camp.folk1.coin3","altar.lancevale-camp.folk1.coin4","altar.lancevale-camp.folk1.coin5"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","outfit":"outfit.travel","legs":"legs.wraps","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"umber","eyes":"leaf","outfit.1":"umber","legs.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":6,"map":"altar.lancevale-camp.tent-1","x":1,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"altar.lancevale-camp","x":22,"y":10,"activity":"work"},{"from":12,"to":13,"map":"altar.lancevale-camp.tent-1","x":3,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.lancevale-camp","x":22,"y":10,"activity":"work"},{"from":18,"to":21,"map":"altar.lancevale-camp.tent-1","x":3,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.lancevale-camp.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk1"}},{"id":"altar.lancevale-camp.folk2","type":"actor/person/priest","name":{"en":"Urban Lilyhold","zh":"乌尔班·百合堡"},"place":{"on":"tile","map":"altar.lancevale-camp","x":16,"y":12},"facing":"down","props":{"age":45,"household":"altar.lancevale-camp.h1","purse":6,"favourite":"item/material/herb"},"contents":["altar.lancevale-camp.folk2.coin0","altar.lancevale-camp.folk2.coin1","altar.lancevale-camp.folk2.coin2","altar.lancevale-camp.folk2.coin3","altar.lancevale-camp.folk2.coin4","altar.lancevale-camp.folk2.coin5"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","beard":"beard.full","outfit":"outfit.vestment","legs":"legs.hose","shoes":"shoes.sandals"},"colors":{"skin":"tan","hair":"silver","eyes":"amber","outfit.1":"ivory","outfit.2":"indigo","legs.1":"umber","shoes.1":"leather"}},"npc":{"role":"priest","schedule":[{"from":22,"to":5,"map":"altar.lancevale-camp.tent-2","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"altar.lancevale-camp","x":16,"y":12,"activity":"work"},{"from":12,"to":13,"map":"altar.lancevale-camp.tent-2","x":3,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.lancevale-camp","x":16,"y":12,"activity":"work"},{"from":18,"to":22,"map":"altar.lancevale-camp","x":11,"y":20,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"hour:morning","text":{"en":"Morning prayers are just over. If you want holy water, you will have to wait for the deacon; he has the key.","zh":"晨祷刚做完。你若要领圣水，得等执事回来，钥匙在他身上。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.lancevale-camp.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk2.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk2.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancevale-camp.folk2"}},{"id":"altar.lancevale-camp.folk3","type":"actor/person/traveler","name":{"en":"Basil Lilyhold","zh":"巴西尔·百合堡"},"place":{"on":"tile","map":"altar.lanceval