ery":150},{"types":{"item/material/stone":1},"on":["grass"],"max":5,"every":150},{"types":{"item/material/grass":1},"on":["grass","drygrass"],"max":6,"every":150}],"music":"ruins","light":"outdoor","zone":"combat","site":{"map":"overworld","x":9,"y":4,"size":1},"edgesWhen":"world.part2"},"entities":[{"id":"abbey~1","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"abbey","x":6,"y":19},"name":{"en":"A memorial stone","zh":"纪念碑"},"props":{"text":"BROTHER ODO OF THE THORN, who held the gate at Varn for three days. He lies with his brothers under Thornwood Hollow; his name is kept here.","text_zh":"荆棘修士奥多。曾独守瓦恩城门三日。遗骨与众弟兄同葬于荆棘谷之下，其名留存于此。"}},{"id":"abbey~2","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"abbey","x":8,"y":19},"name":{"en":"A memorial stone","zh":"纪念碑"},"props":{"text":"SISTER MAREN OF THE THORN, who carried water to both armies. She lies with the Order under Thornwood Hollow; her name is kept here.","text_zh":"荆棘修女玛伦。两军交战之时，曾为双方送水。遗骨与骑士团同葬于荆棘谷之下，其名留存于此。"}},{"id":"abbey~3","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"abbey","x":10,"y":19},"name":{"en":"A memorial stone","zh":"纪念碑"},"props":{"text":"BROTHER TOMAS OF THE THORN, sworn brother to the Commander, sent down to ward the Order's dead under the hollow. No year of death is cut on the stone.","text_zh":"荆棘修士托马斯，骑士长的誓约兄弟。奉命下至荆棘谷之下，看守骑士团的亡者。碑上没有刻卒年。"}},{"id":"abbey~4","type":"fixture/sacred/gravestone","place":{"on":"tile","map":"abbey","x":12,"y":19},"name":{"en":"A grave in the yard","zh":"院中的墓"},"props":{"text":"BROTHER GILES, GARDENER, buried in the yard he kept. Rose canes, long dead, are still tied to the stone.","text_zh":"园丁吉尔斯修士，葬于他照料过的院中。墓碑上还绑着几根早已枯死的玫瑰枝。"}},{"id":"abbey~5","type":"fixture/sacred/altar","place":{"on":"tile","map":"abbey","x":19,"y":12},"name":{"en":"The statue in the thorn yard","zh":"荆棘院中的雕像"},"tags":["readable"],"props":{"text":"A young knight on one knee before a child, holding out a wooden horse he has mended. The face is worn 