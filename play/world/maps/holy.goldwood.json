":"holy.goldwood","x":38,"y":15},"facing":"down","props":{"age":35,"household":"holy.goldwood.h0","purse":3,"favourite":"item/food/fish/perch"},"contents":["holy.goldwood.folk0.coin0","holy.goldwood.folk0.coin1","holy.goldwood.folk0.coin2"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.keen","hat":"hat.straw","outfit":"outfit.workshirt","legs":"legs.wraps","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"copper","eyes":"storm","hat.1":"linen","outfit.1":"undyed","outfit.2":"slate","legs.1":"linen","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"holy.goldwood.home-1","x":2,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"holy.goldwood","x":38,"y":15,"activity":"work"},{"from":12,"to":13,"map":"holy.goldwood.home-1","x":7,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.goldwood","x":38,"y":15,"activity":"work"},{"from":18,"to":21,"map":"holy.goldwood.home-1","x":7,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.goldwood.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk0"}},{"id":"holy.goldwood.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk0"}},{"id":"holy.goldwood.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk0"}},{"id":"holy.goldwood.folk1","type":"actor/person/fisher","name":{"en":"Marina Lambwright","zh":"玛丽娜·羔匠"},"place":{"on":"tile","map":"holy.goldwood","x":20,"y":18},"facing":"down","props":{"age":43,"household":"holy.goldwood.h1","purse":6,"favourite":"item/material/gold_ingot","stock":"item/food/fish/raw*3|item/misc/bait*3"},"tags":["merchant"],"contents":["holy.goldwood.folk1.s0.0","holy.goldwood.folk1.s0.1","holy.goldwood.folk1.s0.2","holy.goldwood.folk1.s1.0","holy.goldwood.folk1.s1.1","holy.goldwood.folk1.s1.2","holy.goldwood.folk1.coin0","holy.goldwood.folk1.coin1","holy.goldwood.folk1.coin2","holy.goldwood.folk1.coin3","holy.goldwood.folk1.coin4","holy.goldwood.folk1.coin5"],"look":{"body":"woman","parts":{"hair":"hair.bob","face":"face.weary","mark":"mark.scar","outfit":"outfit.oilcloth","shoes":"shoes.sandals"},"colors":{"skin":"porcelain","hair":"lilac","eyes":"bark","outfit.1":"slate","shoes.1":"leather"}},"npc":{"role":"fisher","schedule":[{"from":22,"to":5,"map":"holy.goldwood.home-2","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"holy.goldwood","x":20,"y":18,"activity":"work"},{"from":12,"to":13,"map":"holy.goldwood.home-2","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.goldwood","x":20,"y":18,"activity":"work"},{"from":18,"to":22,"map":"holy.goldwood.home-2","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"weather:rain","text":{"en":"Fish come up in the rain, so I'll stay out a while longer. If you don't mind getting wet, you can watch.","zh":"下雨天鱼爱往上浮，我得多待一会儿。你不怕淋的话，就在边上看着吧。"}},{"key":"default","text":{"en":"The fish have all gone down deep lately. Two all morning, that's all. It wasn't like this in my father's day.","zh":"这阵子鱼都沉到深水里去了，一上午就钓上来两条。我爹那时候可不是这样。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"type":"item/food/fish/raw","id":"holy.goldwood.folk1.s0.0","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"type":"item/food/fish/raw","id":"holy.goldwood.folk1.s0.1","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"type":"item/food/fish/raw","id":"holy.goldwood.folk1.s0.2","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"type":"item/misc/bait","id":"holy.goldwood.folk1.s1.0","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"type":"item/misc/bait","id":"holy.goldwood.folk1.s1.1","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"type":"item/misc/bait","id":"holy.goldwood.folk1.s1.2","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldwood.folk1"}},{"id":"holy.goldwood.folk2","type":"actor/person/child","name":{"en":"Aurelian Lambwright","zh":"奥勒良·羔匠"},"place":{"on":"tile","map":"holy.goldwood.home-2","x":1,"y":2},"facing":"down","props":{"age":12,"household":"holy.goldwood.h1","purse":1,"favourite":"item/misc/doll"},"tags":["minor"],"contents":["holy.goldwood.folk2.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","legs":"legs.hose"},"colors":{"skin":"warm","hair":"gold","eyes":"amber","outfit.1":"umber","legs.1":"moss"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.goldwood.home-2","x":1,"y":2,