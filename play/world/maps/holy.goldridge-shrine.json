":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"hour:morning","text":{"en":"Morning prayers are just over. If you want holy water, you will have to wait for the deacon; he has the key.","zh":"晨祷刚做完。你若要领圣水，得等执事回来，钥匙在他身上。"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"type":"item/light/candle","id":"holy.goldridge-shrine.folk0.s0.0","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"type":"item/light/candle","id":"holy.goldridge-shrine.folk0.s0.1","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"type":"item/light/candle","id":"holy.goldridge-shrine.folk0.s0.2","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"type":"item/vessel/flask/holy_water","id":"holy.goldridge-shrine.folk0.s1.0","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"id":"holy.goldridge-shrine.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"id":"holy.goldridge-shrine.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"id":"holy.goldridge-shrine.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldridge-shrine.folk0"}},{"id":"holy.goldridge-shrine.folk1","type":"actor/person/traveler","name":{"en":"Tiberius Palmcroft","zh":"提比略·棕园"},"place":{"on":"tile","map":"holy.goldridge-shrine","x":17,"y":12},"facing":"down","props":{"age":50,"household":"holy.goldridge-shrine.h0","purse":2,"favourite":"item/food/berries"},"contents":["holy.goldridge-shrine.folk1.coin0","holy.goldridge-shrine.folk1.coin1"],"look":{"body":"man","parts":{"hair":"hair.braid","face":"face.weary","beard":"beard.moustache","outfit":"outfit.cloak","shoes":"shoes.boots"},"colors":{"skin":"brown","hair":"steelgrey","eyes":"hazel","outfit.1":"umber","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"holy.goldridge-shrine","x":17,"y":12,"activity":"sleep"},{"from":7,"to":12,"map":"holy.goldridge-shrine","x":18,"y":12,"activity":"work"},{"from":12,"to":13,"map":"holy.goldridge-shrine","x":17,"y":12,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.goldridge-shrine","x":18,"y":12,"activity":"work"},{"from":18,"to":22,"map":"holy.goldridge-shrine","x":17,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.goldridge-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldridge-shrine.folk1"}},{"id":"holy.goldridge-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.goldridge-shrine.folk1"}}]}