ype":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk0"}},{"id":"altar.martyrford-shrine.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk0"}},{"id":"altar.martyrford-shrine.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk0"}},{"id":"altar.martyrford-shrine.folk1","type":"actor/person/traveler","name":{"en":"Jerome Candleward","zh":"哲罗姆·烛守"},"place":{"on":"tile","map":"altar.martyrford-shrine","x":14,"y":13},"facing":"down","props":{"age":52,"household":"altar.martyrford-shrine.h0","purse":4,"favourite":"item/food/honey"},"contents":["altar.martyrford-shrine.folk1.coin0","altar.martyrford-shrine.folk1.coin1","altar.martyrford-shrine.folk1.coin2","altar.martyrford-shrine.folk1.coin3"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.weary","beard":"beard.stubble","outfit":"outfit.cloak","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"ash","eyes":"amber","outfit.1":"slate","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"altar.martyrford-shrine","x":14,"y":13,"activity":"sleep"},{"from":7,"to":12,"map":"altar.martyrford-shrine","x":19,"y":11,"activity":"work"},{"from":12,"to":13,"map":"altar.martyrford-shrine","x":14,"y":13,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.martyrford-shrine","x":19,"y":11,"activity":"work"},{"from":18,"to":22,"map":"altar.martyrford-shrine","x":8,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.martyrford-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk1"}},{"id":"altar.martyrford-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk1"}},{"id":"altar.martyrford-shrine.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk1"}},{"id":"altar.martyrford-shrine.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.martyrford-shrine.folk1"}}]}