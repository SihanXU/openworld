edmarch.spearholm.home-3","x":5,"y":2},"facing":"down","props":{"age":51,"household":"redmarch.spearholm.h3","purse":5,"favourite":"item/material/cloth"},"contents":["redmarch.spearholm.folk5.coin0","redmarch.spearholm.folk5.coin1","redmarch.spearholm.folk5.coin2","redmarch.spearholm.folk5.coin3","redmarch.spearholm.folk5.coin4"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.soft","mark":"mark.scar","outfit":"outfit.dress","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"umber","eyes":"storm","outfit.1":"rose","outfit.2":"linen","shoes.1":"black"}},"npc":{"role":"villager","schedule":[{"from":22,"to":7,"map":"redmarch.spearholm.home-3","x":5,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.spearholm.home-3","x":2,"y":4,"activity":"work"},{"from":12,"to":13,"map":"redmarch.spearholm.home-3","x":7,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.spearholm.home-3","x":2,"y":4,"activity":"work"},{"from":18,"to":22,"map":"redmarch.spearholm","x":21,"y":19,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.spearholm.folk5.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk5"}},{"id":"redmarch.spearholm.folk5.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk5"}},{"id":"redmarch.spearholm.folk5.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk5"}},{"id":"redmarch.spearholm.folk5.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk5"}},{"id":"redmarch.spearholm.folk5.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk5"}},{"id":"redmarch.spearholm.folk6","type":"actor/person/farmer","name":{"en":"Brunhild Reddale","zh":"布伦希尔德·赤谷"},"place":{"on":"tile","map":"redmarch.spearholm","x":35,"y":11},"facing":"down","props":{"age":48,"household":"redmarch.spearholm.h3","purse":3,"favourite":"item/light/lantern"},"contents":["redmarch.spearholm.folk6.coin0","redmarch.spearholm.folk6.coin1","redmarch.spearholm.folk6.coin2"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.soft","hat":"hat.kerchief","outfit":"outfit.workdress"},"colors":{"skin":"brown","hair":"umber","eyes":"amber","hat.1":"slate","outfit.1":"slate","outfit.2":"undyed"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"redmarch.spearholm.home-3","x":3,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.spearholm","x":35,"y":11,"activity":"work"},{"from":12,"to":13,"map":"redmarch.spearholm.home-3","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.spearholm","x":35,"y":11,"activity":"work"},{"from":18,"to":21,"map":"redmarch.spearholm.home-3","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.spearholm.folk6.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk6"}},{"id":"redmarch.spearholm.folk6.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk6"}},{"id":"redmarch.spearholm.folk6.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk6"}},{"id":"redmarch.spearholm.folk7","type":"actor/person/child","name":{"en":"Mirka Reddale","zh":"米尔卡·赤谷"},"place":{"on":"tile","map":"redmarch.spearholm.home-3","x":6,"y":1},"facing":"down","props":{"age":7,"household":"redmarch.spearholm.h3","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["redmarch.spearholm.folk7.coin0"],"look":{"body":"girl","parts":{"hair":"hair.pigtails","face":"face.child","outfit":"outfit.pinafore","shoes":"shoes.buckled"},"colors":{"skin":"deep","hair":"auburn","eyes":"leaf","outfit.1":"mustard","shoes.1":"darkleather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"redmarch.spearholm.home-3","x":6,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.spearholm.home-3","x":3,"y":4,"activity":"play"},{"from":12,"to":13,"map":"redmarch.spearholm.home-3","x":5,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.spearholm.home-3","x":3,"y":4,"activity":"play"},{"from":18,"to":20,"map":"redmarch.spearholm.home-3","x":5,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.spearholm.folk7.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk7"}},{"id":"redmarch.spearholm.folk8","type":"actor/person/villager","name":{"en":"Gerhard Ironwright","zh":"格哈德·铁匠"},"place":{"on":"tile","map":"redmarch.spearholm.home-4","x":1,"y":1},"facing":"down","props":{"age":41,"household":"redmarch.spearholm.h4","purse":6,"favourite":"item/material/herb"},"contents":["redmarch.spearholm.folk8.coin0","redmarch.spearholm.folk8.coin1","redmarch.spearholm.folk8.coin2","redmarch.spearholm.folk8.coin3","redmarch.spearholm.folk8.coin4","redmarch.spearholm.folk8.coin5"],"look":{"body":"man","parts":{"hair":"hair.messy","face":"face.stern","beard":"beard.moustache","outfit":"outfit.workshirt","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"gold","eyes":"leaf","outfit.1":"woad","outfit.2":"umber","shoes.1":"darkleather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":7,"map":"redmarch.spearholm.home-4","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.spearholm","x":16,"y":23,"activity":"work"},{"from":12,"to":13,"map":"redmarch.spearholm.home-4","x":3,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.spearholm","x":16,"y":23,"activity":"work"},{"from":18,"to":21,"map":"redmarch.spearholm","x":22,"y":14,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"It gets dark earlier every day. Our lamp oil used to last till spring; this year I doubt it will see midwinter.","zh":"天黑得一天比一天早了。我家的灯油往年能点到开春，今年怕是撑不到冬至。"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.spearholm.folk8.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk8.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk8.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk8.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk8.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk8.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk8"}},{"id":"redmarch.spearholm.folk9","type":"actor/person/villager","name":{"en":"Jelka Ironwright","zh":"耶尔卡·铁匠"},"place":{"on":"tile","map":"redmarch.spearholm.home-4","x":5,"y":2},"facing":"down","props":{"age":35,"household":"redmarch.spearholm.h4","purse":3,"favourite":"item/food/fish/catfish"},"contents":["redmarch.spearholm.folk9.coin0","redmarch.spearholm.folk9.coin1","redmarch.spearholm.folk9.coin2"],"look":{"body":"woman","parts":{"hair":"hair.wavy","face":"face.keen","outfit":"outfit.dress","shoes":"shoes.sandals"},"colors":{"skin":"tan","hair":"umber","eyes":"bark","outfit.1":"umber","outfit.2":"ivory","shoes.1":"umber"}},"npc":{"role":"villager","schedule":[{"from":22,"to":6,"map":"redmarch.spearholm.home-4","x":2,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.spearholm.home-4","x":5,"y":2,"activity":"work"},{"from":12,"to":13,"map":"redmarch.spearholm.home-4","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"