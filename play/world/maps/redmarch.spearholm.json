h.spearholm.home-4","x":8,"y":2,"activity":"play"},{"from":12,"to":13,"map":"redmarch.spearholm.home-4","x":7,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.spearholm.home-4","x":8,"y":2,"activity":"play"},{"from":18,"to":20,"map":"redmarch.spearholm.home-4","x":7,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.spearholm.folk10.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.spearholm.folk10"}},{"id":"redmarch.spearholm.folk11","type":"actor/person/villager","name":{"en":"Ratko Redward","zh":"拉特科·赤守"},"place":{"on":"tile","map":"redmarch.spearholm.home-5","x":7,"y":3},"facing":"down","props":{"age":44,"household":"redmarch.spearholm.h5","purse":2,"favourite":"item/misc/dice"},"contents":["redmarch.spearholm.folk11.coin0","redmarch.spearholm.folk11.coin1"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.keen","beard":"beard.stubble","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"copper","eyes":"hazel","outfit.1":"undyed","outfit.2":"slate","shoes.1":"darkleather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":5,"map":"redmarch.spearholm.home-5","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.spearholm.home-5","x":7,"y":3,"activity":"work"},{"from":12,"to":13,