","type":"fixture/light/candles","place":{"on":"tile","map":"palefen.fogby-shrine","x":17,"y":10}},{"id":"palefen.fogby-shrine~a","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.fogby-shrine","x":11,"y":7}},{"id":"palefen.fogby-shrine~b","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.fogby-shrine","x":12,"y":12}},{"id":"palefen.fogby-shrine~c","type":"fixture/nature/flowers","place":{"on":"tile","map":"palefen.fogby-shrine","x":13,"y":12}},{"id":"palefen.fogby-shrine.folk0","type":"actor/person/priest","name":{"en":"Eamon Fogward","zh":"埃蒙·雾守"},"place":{"on":"tile","map":"palefen.fogby-shrine","x":15,"y":7},"facing":"down","props":{"age":54,"household":"palefen.fogby-shrine.h0","purse":5,"favourite":"item/food/pie","stock":"item/light/candle*3|item/vessel/flask/holy_water*1"},"tags":["merchant"],"contents":["palefen.fogby-shrine.folk0.s0.0","palefen.fogby-shrine.folk0.s0.1","palefen.fogby-shrine.folk0.s0.2","palefen.fogby-shrine.folk0.s1.0","palefen.fogby-shrine.folk0.coin0","palefen.fogby-shrine.folk0.coin1","palefen.fogby-shrine.folk0.coin2","palefen.fogby-shrine.folk0.coin3","palefen.fogby-shrine.folk0.coin4"],"look":{"body":"man","parts":{"hair":"hair.thin","face":"face.keen","outfit":"outfit.tunic","shoes":"shoes.sandals"},"colors":{"skin":"tan","hair":"silver","eyes":"bark","outfit.1":"mustard","shoes.1":"leather"}},"npc":{"role":"priest","schedule":[{"from":22,"to":5,"map":"palefen.fogby-shrine","x":15,"y":15,"activity":"sleep"},{"from":5,"to":12,"map":"palefen.fogby-shrine","x":15,"y":7,"activity":"work"},{"from":12,"to":13,"map":"palefen.fogby-shrine","x":15,"y":15,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.fogby-shrine","x":15,"y":7,"activity":"work"},{"from":18,"to":22,"map":"palefen.fogby-shrine","x":15,"y":15,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Those who come to pray these days ask for longer days and quiet nights. I tell them what the Church teaches: suffering brings us closer to God.","zh":"近来来祷告的人，求的多是白昼长些、夜里平安。我便照教会的教导告诉他们：苦难使人接近神。"}},{"key":"default","text":{"en":"If you are weary, traveller, come in and sit. Many come to light candles of late; the chapel is brighter than it used to be.","zh":"旅人，若是累了，便进来坐坐。近来点烛的人多，堂里倒比往日亮些。"}},{"key":"default","text":{"en":"Keep to the boards and stay out of the mud. And if you hear anything from the graveyard at night, don't go and look.","zh":"走路踩着木板走，别下到泥里。还有，夜里墓地那边要是有动静，别过去看。"}}]}}},{"type":"item/light/candle","id":"palefen.fogby-shrine.folk0.s0.0","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.fogby-shrine.folk0.s0.1","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"type":"item/light/candle","id":"palefen.fogby-shrine.folk0.s0.2","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"type":"item/vessel/flask/holy_water","id":"palefen.fogby-shrine.folk0.s1.0","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk0.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk0"}},{"id":"palefen.fogby-shrine.folk1","type":"actor/person/traveler","name":{"en":"Colm Fogward","zh":"科尔姆·雾守"},"place":{"on":"tile","map":"palefen.fogby-shrine","x":13,"y":12},"facing":"down","props":{"age":55,"household":"palefen.fogby-shrine.h0","purse":3,"favourite":"item/food/fish/catfish"},"contents":["palefen.fogby-shrine.folk1.coin0","palefen.fogby-shrine.folk1.coin1","palefen.fogby-shrine.folk1.coin2"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.weary","age":"age.lined","outfit":"outfit.tunic","shoes":"shoes.boots"},"colors":{"skin":"tan","hair":"steelgrey","eyes":"storm","outfit.1":"undyed","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"palefen.fogby-shrine","x":13,"y":12,"activity":"sleep"},{"from":7,"to":12,"map":"palefen.fogby-shrine","x":18,"y":22,"activity":"work"},{"from":12,"to":13,"map":"palefen.fogby-shrine","x":13,"y":12,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"palefen.fogby-shrine","x":18,"y":22,"activity":"work"},{"from":18,"to":22,"map":"palefen.fogby-shrine","x":13,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"We haven't seen the sun for days. Noon looks much like evening here, and washing won't dry in a week.","zh":"这里好几天没见着太阳了，晌午跟傍晚差不多。晾的衣服一个礼拜都不干。"}}]}}},{"id":"palefen.fogby-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk1"}},{"id":"palefen.fogby-shrine.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk1"}},{"id":"palefen.fogby-shrine.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"palefen.fogby-shrine.folk1"}}]}