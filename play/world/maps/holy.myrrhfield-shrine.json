ile","map":"holy.myrrhfield-shrine","x":15,"y":18},"facing":"down","props":{"age":21,"household":"holy.myrrhfield-shrine.h0","purse":4,"favourite":"item/food/mushroom/roasted"},"contents":["holy.myrrhfield-shrine.folk1.coin0","holy.myrrhfield-shrine.folk1.coin1","holy.myrrhfield-shrine.folk1.coin2","holy.myrrhfield-shrine.folk1.coin3"],"look":{"body":"woman","parts":{"hair":"hair.ponytail","face":"face.keen","hat":"hat.hood","outfit":"outfit.travel","shoes":"shoes.boots"},"colors":{"skin":"porcelain","hair":"black","eyes":"amber","hat.1":"slate","outfit.1":"mustard","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":6,"map":"holy.myrrhfield-shrine","x":16,"y":8,"activity":"sleep"},{"from":6,"to":12,"map":"holy.myrrhfield-shrine","x":15,"y":18,"activity":"work"},{"from":12,"to":13,"map":"holy.myrrhfield-shrine","x":16,"y":8,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.myrrhfield-shrine","x":15,"y":18,"activity":"work"},{"from":18,"to":21,"map":"holy.myrrhfield-shrine","x":17,"y":20,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.myrrhfield-shrine.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhfield-shrine.folk1"}},{"id":"holy.myrrhfield-shrine.folk1.coin1","type":"item/misc/thorn