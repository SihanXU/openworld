"},"place":{"on":"tile","map":"altar.whitewell-camp","x":18,"y":17},"facing":"down","props":{"age":37,"household":"altar.whitewell-camp.h3","purse":6,"favourite":"item/material/frostcap"},"contents":["altar.whitewell-camp.folk5.coin0","altar.whitewell-camp.folk5.coin1","altar.whitewell-camp.folk5.coin2","altar.whitewell-camp.folk5.coin3","altar.whitewell-camp.folk5.coin4","altar.whitewell-camp.folk5.coin5"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.stern","outfit":"outfit.travel","shoes":"shoes.shoes"},"colors":{"skin":"warm","hair":"umber","eyes":"leaf","outfit.1":"teal","shoes.1":"black"}},"npc":{"role":"traveler","schedule":[{"from":21,"to":6,"map":"altar.whitewell-camp.tent-4","x":1,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"altar.whitewell-camp","x":18,"y":17,"activity":"work"},{"from":12,"to":13,"map":"altar.whitewell-camp.tent-4","x":2,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitewell-camp","x":18,"y":17,"activity":"work"},{"from":18,"to":21,"map":"altar.whitewell-camp.tent-4","x":2,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.whitewell-camp.folk5.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk5.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk5.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk5.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk5.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk5.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk5"}},{"id":"altar.whitewell-camp.folk6","type":"actor/person/traveler","name":{"en":"Anselm Dovehold","zh":"安瑟伦·鸽堡"},"place":{"on":"tile","map":"altar.whitewell-camp","x":27,"y":18},"facing":"down","props":{"age":44,"household":"altar.whitewell-camp.h3","purse":6,"favourite":"item/food/pie"},"contents":["altar.whitewell-camp.folk6.coin0","altar.whitewell-camp.folk6.coin1","altar.whitewell-camp.folk6.coin2","altar.whitewell-camp.folk6.coin3","altar.whitewell-camp.folk6.coin4","altar.whitewell-camp.folk6.coin5"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.weary","hat":"hat.hood","outfit":"outfit.travel","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"fair","hair":"chestnut","eyes":"violet","hat.1":"forest","outfit.1":"russet","legs.1":"linen","shoes.1":"darkleather"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":5,"map":"altar.whitewell-camp.tent-4","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"altar.whitewell-camp","x":27,"y":18,"activity":"work"},{"from":12,"to":13,"map":"altar.whitewell-camp.tent-4","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitewell-camp","x":27,"y":18,"activity":"work"},{"from":18,"to":22,"map":"altar.whitewell-camp.tent-4","x":4,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Six days on the road to get here, and I've worn through my soles. Is there a cobbler round here?","zh":"我走了六天才到这儿，鞋底都磨穿了。这附近有补鞋的吗？"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitewell-camp.folk6.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}},{"id":"altar.whitewell-camp.folk6.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}},{"id":"altar.whitewell-camp.folk6.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}},{"id":"altar.whitewell-camp.folk6.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}},{"id":"altar.whitewell-camp.folk6.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}},{"id":"altar.whitewell-camp.folk6.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitewell-camp.folk6"}}]}