:"Osbert Flaxwell","zh":"奥斯伯特·麻井"},"place":{"on":"tile","map":"tithe.saltholm-farm","x":10,"y":22},"facing":"down","props":{"age":33,"household":"tithe.saltholm-farm.h0","purse":5,"favourite":"item/food/berries"},"contents":["tithe.saltholm-farm.folk0.coin0","tithe.saltholm-farm.folk0.coin1","tithe.saltholm-farm.folk0.coin2","tithe.saltholm-farm.folk0.coin3","tithe.saltholm-farm.folk0.coin4"],"look":{"body":"man","parts":{"hair":"hair.messy","face":"face.keen","beard":"beard.stubble","hat":"hat.straw","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"black","eyes":"hazel","hat.1":"mustard","outfit.1":"undyed","outfit.2":"moss","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":6,"map":"tithe.saltholm-farm.farmhouse-1","x":6,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"tithe.saltholm-farm","x":10,"y":22,"activity":"work"},{"from":12,"to":13,"map":"tithe.saltholm-farm.farmhouse-1","x":3,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.saltholm-farm","x":10,"y":22,"activity":"work"},{"from":18,"to":22,"map":"tithe.saltholm-farm.farmhouse-1","x":3,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.saltholm-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk0"}},{"id":"tithe.saltholm-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk0"}},{"id":"tithe.saltholm-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk0"}},{"id":"tithe.saltholm-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk0"}},{"id":"tithe.saltholm-farm.folk0.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk0"}},{"id":"tithe.saltholm-farm.folk1","type":"actor/person/farmer","name":{"en":"Wenna Flaxwell","zh":"温娜·麻井"},"place":{"on":"tile","map":"tithe.saltholm-farm","x":24,"y":3},"facing":"down","props":{"age":41,"household":"tithe.saltholm-farm.h0","purse":2,"favourite":"item/misc/doll"},"contents":["tithe.saltholm-farm.folk1.coin0","tithe.saltholm-farm.folk1.coin1"],"look":{"body":"woman","parts":{"hair":"hair.short","face":"face.keen","hat":"hat.straw","outfit":"outfit.workdress","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"umber","eyes":"storm","hat.1":"ochre","outfit.1":"russet","outfit.2":"linen","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":6,"map":"tithe.saltholm-farm.farmhouse-1","x":5,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"tithe.saltholm-farm","x":24,"y":3,"activity":"work"},{"from":12,"to":13,"map":"tithe.saltholm-farm.farmhouse-1","x":3,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.saltholm-farm","x":24,"y":3,"activity":"work"},{"from":18,"to":21,"map":"tithe.saltholm-farm.farmhouse-1","x":3,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"Every sack of grain is weighed first, and the granary takes its share before we get ours. This year, after that, we have half a sack left.","zh":"麦子收上来先过秤，交够粮仓的份才轮到自家。今年交完，家里就剩小半袋。"}}]}}},{"id":"tithe.saltholm-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk1"}},{"id":"tithe.saltholm-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk1"}},{"id":"tithe.saltholm-farm.folk2","type":"actor/person/elder","name":{"en":"Edith Flaxwell","zh":"伊迪丝·麻井"},"place":{"on":"tile","map":"tithe.saltholm-farm","x":24,"y":13},"facing":"down","props":{"age":71,"household":"tithe.saltholm-farm.h0","purse":4,"favourite":"item/misc/doll"},"contents":["tithe.saltholm-farm.folk2.coin0","tithe.saltholm-farm.folk2.coin1","tithe.saltholm-farm.folk2.coin2","tithe.saltholm-farm.folk2.coin3"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.keen","age":"age.lined","outfit":"outfit.dress","shoes":"shoes.sandals"},"colors":{"skin":"fair","hair":"silver","eyes":"sky","outfit.1":"umber","outfit.2":"undyed","shoes.1":"umber"}},"npc":{"role":"elder","schedule":[{"from":22,"to":6,"map":"tithe.saltholm-farm.farmhouse-1","x":1,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"tithe.saltholm-farm","x":24,"y":13,"activity":"sit"},{"from":12,"to":13,"map":"tithe.saltholm-farm.farmhouse-1","x":6,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"tithe.saltholm-farm","x":24,"y":13,"activity":"sit"},{"from":18,"to":22,"map":"tithe.saltholm-farm.farmhouse-1","x":6,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"The well has gone too salty to drink. We walk the better part of an hour for water now.","zh":"井水咸得没法喝了，现在挑一趟水得走大半个时辰。"}}]}}},{"id":"tithe.saltholm-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk2"}},{"id":"tithe.saltholm-farm.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk2"}},{"id":"tithe.saltholm-farm.folk2.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk2"}},{"id":"tithe.saltholm-farm.folk2.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"tithe.saltholm-farm.folk2"}}]}