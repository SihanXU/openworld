":"hat.kerchief","outfit":"outfit.dress","shoes":"shoes.buckled"},"colors":{"skin":"tan","hair":"snow","eyes":"hazel","hat.1":"russet","outfit.1":"mustard","outfit.2":"ivory","shoes.1":"darkleather"}},"npc":{"role":"elder","schedule":[{"from":22,"to":7,"map":"redmarch.hawkholm.home-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.hawkholm","x":5,"y":15,"activity":"sit"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-1","x":6,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm","x":5,"y":15,"activity":"sit"},{"from":18,"to":22,"map":"redmarch.hawkholm.home-1","x":6,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Sit down, sit down, don't stand there. My legs aren't what they were, and looking up at you hurts my neck.","zh":"坐吧，坐吧，别站着。我这腿不中用了，仰着头跟你说话，脖子疼。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.hawkholm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk0"}},{"id":"redmarch.hawkholm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk0"}},{"id":"redmarch.hawkholm.folk1","type":"actor/person/villager","name":{"en":"Ratko Boarward","zh":"拉特科·猪守"},"place":{"on":"tile","map":"redmarch.hawkholm.home-1","x":6,"y":2},"facing":"down","props":{"age":36,"household":"redmarch.hawkholm.h0","purse":6,"favourite":"item/food/fish/catfish"},"contents":["redmarch.hawkholm.folk1.coin0","redmarch.hawkholm.folk1.coin1","redmarch.hawkholm.folk1.coin2","redmarch.hawkholm.folk1.coin3","redmarch.hawkholm.folk1.coin4","redmarch.hawkholm.folk1.coin5"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.bright","mark":"mark.scar","hat":"hat.cap","outfit":"outfit.tunic","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"umber","eyes":"sky","hat.1":"undyed","outfit.1":"forest","shoes.1":"darkleather"}},"npc":{"role":"villager","schedule":[{"from":22,"to":5,"map":"redmarch.hawkholm.home-1","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.hawkholm.home-1","x":6,"y":2,"activity":"work"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-1","x":7,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm.home-1","x":6,"y":2,"activity":"work"},{"from":18,"to":22,"map":"redmarch.hawkholm","x":18,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.hawkholm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk1"}},{"id":"redmarch.hawkholm.folk2","type":"actor/person/farmer","name":{"en":"Gerhard Redmere","zh":"格哈德·赤湖"},"place":{"on":"tile","map":"redmarch.hawkholm","x":7,"y":14},"facing":"down","props":{"age":37,"household":"redmarch.hawkholm.h1","purse":2,"favourite":"item/food/egg/boiled"},"contents":["redmarch.hawkholm.folk2.coin0","redmarch.hawkholm.folk2.coin1"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.stern","mark":"mark.scar","hat":"hat.straw","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"warm","hair":"umber","eyes":"amber","hat.1":"linen","outfit.1":"ochre","outfit.2":"umber","shoes.1":"leather"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"redmarch.hawkholm.home-2","x":1,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.hawkholm","x":7,"y":14,"activity":"work"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-2","x":3,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm","x":7,"y":14,"activity":"work"},{"from":18,"to":21,"map":"redmarch.hawkholm","x":15,"y":7,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"red