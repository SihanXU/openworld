":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm.home-3","x":7,"y":3,"activity":"work"},{"from":18,"to":21,"map":"redmarch.hawkholm","x":23,"y":10,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.hawkholm.folk4.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk4.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk4.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk4.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk4.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk4.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk4"}},{"id":"redmarch.hawkholm.folk5","type":"actor/person/farmer","name":{"en":"Stanko Spearcroft","zh":"斯坦科·矛园"},"place":{"on":"tile","map":"redmarch.hawkholm","x":25,"y":17},"facing":"down","props":{"age":34,"household":"redmarch.hawkholm.h2","purse":5,"favourite":"item/material/wax"},"contents":["redmarch.hawkholm.folk5.coin0","redmarch.hawkholm.folk5.coin1","redmarch.hawkholm.folk5.coin2","redmarch.hawkholm.folk5.coin3","redmarch.hawkholm.folk5.coin4"],"look":{"body":"man","parts":{"hair":"hair.ponytail","face":"face.keen","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"auburn","eyes":"hazel","outfit.1":"ochre","outfit.2":"slate","shoes.1":"umber"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"redmarch.hawkholm.home-3","x":2,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"redmarch.hawkholm","x":25,"y":17,"activity":"work"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-3","x":6,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm","x":25,"y":17,"activity":"work"},{"from":18,"to":21,"map":"redmarch.hawkholm","x":18,"y":11,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.hawkholm.folk5.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk5"}},{"id":"redmarch.hawkholm.folk5.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk5"}},{"id":"redmarch.hawkholm.folk5.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk5"}},{"id":"redmarch.hawkholm.folk5.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk5"}},{"id":"redmarch.hawkholm.folk5.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk5"}},{"id":"redmarch.hawkholm.folk6","type":"actor/person/child","name":{"en":"Bogdan Spearcroft","zh":"博格丹·矛园"},"place":{"on":"tile","map":"redmarch.hawkholm.home-3","x":2,"y":1},"facing":"down","props":{"age":6,"household":"redmarch.hawkholm.h2","purse":1,"favourite":"item/food/berries"},"tags":["minor"],"contents":["redmarch.hawkholm.folk6.coin0"],"look":{"body":"boy","parts":{"hair":"hair.tuft","face":"face.child","outfit":"outfit.smock","legs":"legs.hose","shoes":"shoes.shoes"},"colors":{"skin":"light","hair":"umber","eyes":"sky","outfit.1":"linen","legs.1":"moss","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"redmarch.hawkholm.home-3","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"redmarch.hawkholm","x":12,"y":21,"activity":"play"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-3","x":4,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm","x":12,"y":21,"activity":"play"},{"from":18,"to":20,"map":"redmarch.hawkholm.home-3","x":4,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The fort has been taking men again. Both the neighbours' sons went last month, and there hasn't been a letter since.","zh":"要塞又来征人了。隔壁家两个儿子上个月都走了，到现在一封信也没有。"}}]}}},{"id":"redmarch.hawkholm.folk6.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk6"}},{"id":"redmarch.hawkholm.folk7","type":"actor/person/villager","name":{"en":"Bogdan Rustcroft","zh":"博格丹·锈园"},"place":{"on":"tile","map":"redmarch.hawkholm.home-4","x":6,"y":3},"facing":"down","props":{"age":30,"household":"redmarch.hawkholm.h3","purse":6,"favourite":"item/food/fish/cooked"},"contents":["redmarch.hawkholm.folk7.coin0","redmarch.hawkholm.folk7.coin1","redmarch.hawkholm.folk7.coin2","redmarch.hawkholm.folk7.coin3","redmarch.hawkholm.folk7.coin4","redmarch.hawkholm.folk7.coin5"],"look":{"body":"man","parts":{"hair":"hair.messy","face":"face.bright","beard":"beard.stubble","outfit":"outfit.workshirt","legs":"legs.hose"},"colors":{"skin":"warm","hair":"ash","eyes":"sky","outfit.1":"ochre","outfit.2":"moss","legs.1":"linen"}},"npc":{"role":"villager","schedule":[{"from":21,"to":6,"map":"redmarch.hawkholm.home-4","x":2,"y":1,"activity":"sleep"},{"from":6,"to":12,"map":"redmarch.hawkholm.home-4","x":6,"y":3,"activity":"work"},{"from":12,"to":13,"map":"redmarch.hawkholm.home-4","x":5,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"redmarch.hawkholm.home-4","x":6,"y":3,"activity":"work"},{"from":18,"to":21,"map":"redmarch.hawkholm","x":19,"y":22,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"Done at last. I'll fetch a bucket from the well, and then there's supper to make for the whole house.","zh":"活总算干完了。我去井边打桶水，回来还得给一家子做饭。"}},{"key":"default","text":{"en":"It gets dark earlier every day. Our lamp oil used to last till spring; this year I doubt it will see midwinter.","zh":"天黑得一天比一天早了。我家的灯油往年能点到开春，今年怕是撑不到冬至。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.hawkholm.folk7.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk7"}},{"id":"redmarch.hawkholm.folk7.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.hawkholm.folk7"}},{"id":"redmarch.hawkholm.folk7.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarc