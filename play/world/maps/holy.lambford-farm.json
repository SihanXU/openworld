rowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.lambford-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.lambford-farm.folk0"}},{"id":"holy.lambford-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.lambford-farm.folk0"}},{"id":"holy.lambford-farm.folk1","type":"actor/person/farmer","name":{"en":"Julian Lightcroft","zh":"尤利安·光园"},"place":{"on":"tile","map":"holy.lambford-farm.farmhouse-1","x":1,"y":2},"facing":"down","props":{"age":54,"household":"holy.lambford-farm.h0","purse":5,"favourite":"item/misc/dice"},"contents":["holy.lambford-farm.folk1.coin0","holy.lambford-farm.folk1.coin1","holy.lambford-farm.folk1.coin2","holy.lambford-farm.folk1.coin3","holy.lambford-farm.folk1.coin4"],"look":{"body":"man","parts":{"hair":"hair.thin","face":"face.keen","hat":"hat.straw","outfit":"outfit.workshirt"},"colors":{"skin":"deep","hair":"steelgrey","eyes":"hazel","hat.1":"linen","outfit.1":"linen","outfit.2":"umber"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":7,"map":"holy.lambford-farm.farmhouse-1","x":1,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.lambford-farm","x":30,"y":10,"activity":"work"},{"from":12,"to":13,"map":"holy.lambford-farm.farmhouse-1","x":7,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.lambford-farm","x":30,"y":10,"activity":"work"},{"from":18,"to":22,"map":"holy.lambford-farm.farmhouse-1","x":7,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.lambford-farm.folk1.