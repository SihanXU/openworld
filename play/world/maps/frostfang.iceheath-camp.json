oman","parts":{"hair":"hair.braid","face":"face.soft","outfit":"outfit.cloak","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"steelgrey","eyes":"storm","outfit.1":"forest","shoes.1":"umber"}},"npc":{"role":"traveler","schedule":[{"from":22,"to":7,"map":"frostfang.iceheath-camp.tent-3","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"frostfang.iceheath-camp","x":19,"y":15,"activity":"work"},{"from":12,"to":13,"map":"frostfang.iceheath-camp.tent-3","x":5,"y":1,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.iceheath-camp","x":19,"y":15,"activity":"work"},{"from":18,"to":22,"map":"frostfang.iceheath-camp.tent-3","x":5,"y":1,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"The Church named me for the pilgrimage. They say it is calling people everywhere; of every ten I meet on the road, three or four are on the same errand.","zh":"教会点了我的名，叫我去朝圣。听说各地都在召人，路上碰见的十个人里，倒有三四个跟我一样。"}},{"key":"default","text":{"en":"They say there's a knight on the road past Vesper Ford who stops everyone. Nobody gets by him.","zh":"听说过了晚祷渡的那条大路上，有个骑士把路拦住了，谁也过不去。"}}]}}},{"id":"frostfang.iceheath-camp.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.iceheath-camp.folk3"}},{"id":"frostfang.iceheath-camp.folk3.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.iceheath-camp.folk3"}},{"id":"frostfang.iceheath-camp.folk3.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.iceheath-camp.folk3"}},{"id":"frostfang.iceheath-camp.folk3.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.iceheath-camp.folk3"}},{"id":"frostfang.iceheath-camp.folk3.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.iceheath-camp.folk3"}},{"id":"frostfang.