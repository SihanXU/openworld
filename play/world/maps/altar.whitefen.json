":13,"to":18,"map":"altar.whitefen.home-1","x":3,"y":5,"activity":"work"},{"from":18,"to":21,"map":"altar.whitefen","x":16,"y":18,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"default","text":{"en":"You're not from here, are you? There have been more people on the road than usual lately. They say the Church is calling for pilgrims.","zh":"你是外地来的吧？这阵子路上的人比往年多，听说是教会在召朝圣的人。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.whitefen.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk0"}},{"id":"altar.whitefen.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk0"}},{"id":"altar.whitefen.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk0"}},{"id":"altar.whitefen.folk1","type":"actor/person/villager","name":{"en":"Anselm Whitedale","zh":"安瑟伦·白谷"},"place":{"on":"tile","map":"altar.whitefen.home-1","x":1,"y":1},"facing":"down","props":{"age":27,"household":"altar.whitefen.h0","purse":6,"favourite":"item/food/pie"},"contents":["altar.whitefen.folk1.coin0","altar.whitefen.folk1.coin1","altar.whitefen.folk1.coin2","altar.whitefen.folk1.coin3","altar.whitefen.folk1.coin4","altar.whitefen.folk1.coin5"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.keen","beard":"beard.stubble","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"warm","hair":"gold","eyes":"storm","outfit.1":"ochre","outfit.2":"umber","shoes.1":"