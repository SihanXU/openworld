ype":"actor/person/child","name":{"en":"Thecla Whitedale","zh":"特克拉·白谷"},"place":{"on":"tile","map":"altar.whitefen.home-1","x":2,"y":1},"facing":"down","props":{"age":9,"household":"altar.whitefen.h0","purse":1,"favourite":"item/misc/dice"},"tags":["minor"],"contents":["altar.whitefen.folk2.coin0"],"look":{"body":"girl","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.smock","shoes":"shoes.shoes"},"colors":{"skin":"warm","hair":"auburn","eyes":"storm","outfit.1":"madder","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"altar.whitefen.home-1","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"altar.whitefen","x":7,"y":17,"activity":"play"},{"from":12,"to":13,"map":"altar.whitefen.home-1","x":7,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen","x":7,"y":17,"activity":"play"},{"from":18,"to":20,"map":"altar.whitefen.home-1","x":7,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk2"}},{"id":"altar.whitefen.folk3","type":"actor/person/child","name":{"en":"Ursula Whitedale","zh":"乌尔苏拉·白谷"},"place":{"on":"tile","map":"altar.whitefen.home-1","x":2,"y":2},"facing":"down","props":{"age":10,"household":"altar.whitefen.h0","purse":1,"favourite":"item/food/egg/boiled"},"tags":["minor"],"contents":["altar.whitefen.folk3.coin0"],"look":{"body":"girl","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.smock","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"honey","eyes":"bark","outfit.1":"plum","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"altar.whitefen.home-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"altar.whitefen.home-1","x":6,"y":5,"activity":"play"},{"from":12,"to":13,"map":"altar.whitefen.home-1","x":6,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen.home-1","x":6,"y":5,"activity":"play"},{"from":18,"to":20,"map":"altar.whitefen.home-1","x":6,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk3.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk3"}},{"id":"altar.whitefen.folk4","type":"actor/person/farmer","name":{"en":"Clement Roseward","zh":"克莱门特·玫瑰守"},"place":{"on":"tile","map":"altar.whitefen","x":13,"y":16},"facing":"down","props":{"age":24,"household":"altar.whitefen.h1","purse":5,"favourite":"item/material/fireweed"},"contents":["altar.whitefen.folk4.coin0","altar.whitefen.folk4.coin1","altar.whitefen.folk4.coin2","altar.whitefen.folk4.coin3","altar.whitefen.folk4.coin4"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.keen","beard":"beard.stubble","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"deep","hair":"black","eyes":"hazel","outfit.1":"woad","outfit.2":"slate","shoes.1":"leather"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":5,"map":"altar.whitefen.home-2","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"altar.whitefen","x":13,"y":16,"activity":"work"},{"from":12,"to":13,"map":"altar.whitefen.home-2","x":3,"y":6,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen","x":13,"y":16,"activity":"work"},{"from":18,"to":22,"map":"altar.whitefen.home-2","x":3,"y":6,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.whitefen.folk4.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk4"}},{"id":"altar.whitefen.folk4.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk4"}},{"id":"altar.whitefen.folk4.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk4"}},{"id":"altar.whitefen.folk4.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk4"}},{"id":"altar.whitefen.folk4.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk4"}},{"id":"altar.whitefen.folk5","type":"actor/person/fisher","name":{"en":"Hilda Highwood","zh":"希尔达·高林"