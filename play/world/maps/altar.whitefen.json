,{"from":7,"to":12,"map":"altar.whitefen.home-6","x":2,"y":6,"activity":"play"},{"from":12,"to":13,"map":"altar.whitefen.home-6","x":6,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen.home-6","x":2,"y":6,"activity":"play"},{"from":18,"to":20,"map":"altar.whitefen.home-6","x":6,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk13.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk13"}},{"id":"altar.whitefen.folk14","type":"actor/person/villager","name":{"en":"Benedict Choirward","zh":"本笃·咏守"},"place":{"on":"tile","map":"altar.whitefen","x":29,"y":17},"facing":"down","props":{"age":29,"household":"altar.whitefen.h6","purse":3,"favourite":"item/food/fish/perch"},"contents":["altar.whitefen.folk14.coin0","altar.whitefen.folk14.coin1","altar.whitefen.folk14.coin2"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.bright","beard":"beard.moustache","outfit":"outfit.tunic","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"auburn","eyes":"amber","outfit.1":"ivory","legs.1":"umber","shoes.1":"umber"}},"npc":{"role":"villager","schedule":[{"from":21,"to":6,"map":"altar.whitefen.home-7","x":1,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"altar.whitefen","x":29,"y":17,"activity":"work"},{"from":12,"to":13,"map":"altar.whitefen.home-7","x":7,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen","x":29,"y":17,"activity":"work"},{"from":18,"to":21,"map":"altar.whitefen","x":18,"y":12,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"Watch the rut at the end of the lane. The rain dug it deeper, and a cart tipped over in it the day before yesterday.","zh":"巷口那道车辙你留神点。下过一场雨又冲深了，前天还有辆车在那儿翻了。"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk14.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk14"}},{"id":"altar.whitefen.folk14.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk14"}},{"id":"altar.whitefen.folk14.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk14"}},{"id":"altar.whitefen.folk15","type":"actor/person/child","name":{"en":"Lucia Choirward","zh":"露西娅·咏守"},"place":{"on":"tile","map":"altar.whitefen.home-7","x":1,"y":1},"facing":"down","props":{"age":15,"household":"altar.whitefen.h6","purse":1,"favourite":"item/food/chicken/cooked"},"tags":["minor"],"contents":["altar.whitefen.folk15.coin0"],"look":{"body":"woman","parts":{"hair":"hair.cropped","face":"face.bright","outfit":"outfit.dress","shoes":"shoes.buckled"},"colors":{"skin":"fair","hair":"chestnut","eyes":"bark","outfit.1":"forest","outfit.2":"linen","shoes.1":"plum"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"altar.whitefen.home-7","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"altar.whitefen.home-7","x":7,"y":3,"activity":"play"},{"from":12,"to":13,"map":"altar.whitefen.home-7","x":6,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen.home-7","x":7,"y":3,"activity":"play"},{"from":18,"to":20,"map":"altar.whitefen.home-7","x":6,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"hour:evening","text":{"en":"I have to go home, Mum's calling me for supper. I'm not tired. I'm really not.","zh":"我得回家了，我娘喊我吃饭。我不困，真的不困。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The monastery bell used to ring seven times a day. Now it rings through the night as well, for the vigil, they say.","zh":"修道院的钟以前一天敲七回，现在夜里也敲，说是为了守夜。"}}]}}},{"id":"altar.whitefen.folk15.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk15"}},{"id":"altar.whitefen.folk16","type":"actor/person/child","name":{"en":"Odile Choirward","zh":"奥迪尔·咏守"},"place":{"on":"tile","map":"altar.whitefen.home-7","x":2,"y":1},"facing":"down","props":{"age":13,"household":"altar.whitefen.h6","purse":1,"favourite":"item/food/honey"},"tags":["minor"],"contents":["altar.whitefen.folk16.coin0"],"look":{"body":"girl","parts":{"hair":"hair.pigtails","face":"face.child","outfit":"outfit.pinafore","legs":"legs.hose","shoes":"shoes.boots"},"colors":{"skin":"deep","hair":"black","eyes":"hazel","outfit.1":"woad","legs.1":"slate","shoes.1":"leather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"altar.whitefen.home-7","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"altar.whitefen","x":31,"y":25,"activity":"play"},{"from":12,"to":13,"map":"altar.whitefen.home-7","x":3,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen","x":31,"y":25,"activity":"play"},{"from":18,"to":20,"map":"altar.whitefen.home-7","x":3,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk16.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk16"}},{"id":"altar.whitefen.folk17","type":"actor/person/elder","name":{"en":"Verena Vigilstone","zh":"维蕾娜·守石"},"place":{"on":"tile","map":"altar.whitefen.home-8","x":1,"y":1},"facing":"down","props":{"age":61,"household":"altar.whitefen.h7","purse":3,"favourite":"item/food/fish/pike"},"contents":["altar.whitefen.folk17.coin0","altar.whitefen.folk17.coin1","altar.whitefen.folk17.coin2"],"look":{"body":"woman","parts":{"hair":"hair.tied","face":"face.keen","age":"age.lined","mark":"mark.scar","outfit":"outfit.dress","legs":"legs.hose"},"colors":{"skin":"light","hair":"silver","eyes":"amber","outfit.1":"moss","outfit.2":"ivory","legs.1":"linen"}},"npc":{"role":"elder","schedule":[{"from":21,"to":7,"map":"altar.whitefen.home-8","x":1,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"altar.whitefen","x":17,"y":15,"activity":"sit"},{"from":12,"to":13,"map":"altar.whitefen.home-8","x":4,"y":2,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.whitefen","x":17,"y":15,"activity":"sit"},{"from":18,"to":21,"map":"altar.whitefen.home-8","x":4,"y":2,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.whitefen.folk17.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk17"}},{"id":"altar.whitefen.folk17.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk17"}},{"id":"altar.whitefen.folk17.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.whitefen.folk17"}}]}