ncefield-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancefield-farm.folk0"}},{"id":"altar.lancefield-farm.folk1","type":"actor/person/elder","name":{"en":"Scholastica Marbleford","zh":"思嘉·石渡"},"place":{"on":"tile","map":"altar.lancefield-farm","x":21,"y":11},"facing":"down","props":{"age":63,"household":"altar.lancefield-farm.h0","purse":2,"favourite":"item/light/lantern"},"contents":["altar.lancefield-farm.folk1.coin0","altar.lancefield-farm.folk1.coin1"],"look":{"body":"woman","parts":{"hair":"hair.braid","face":"face.weary","age":"age.lined","outfit":"outfit.dress","legs":"legs.hose","shoes":"shoes.shoes"},"colors":{"skin":"warm","hair":"snow","eyes":"leaf","outfit.1":"umber","outfit.2":"undyed","legs.1":"slate","shoes.1":"umber"}},"npc":{"role":"elder","schedule":[{"from":21,"to":5,"map":"altar.lancefield-farm.farmhouse-1","x":2,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"altar.lancefield-farm","x":21,"y":11,"activity":"sit"},{"from":12,"to":13,"map":"altar.lancefield-farm.farmhouse-1","x":5,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.lancefield-farm","x":21,"y":11,"activity":"sit"},{"from":18,"to":21,"map":"altar.lancefield-farm","x":14,"y":14,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"default","text":{"en":"When I was small, at this time of year it was still light after supper, and we would play outside a good while. Now it's dark before supper is even cooked.","zh":"我小时候，这个时节吃完晚饭天还亮着，我们还能在外面玩好一阵。现在饭还没做好，天就黑了。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.lancefield-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancefield-farm.folk1"}},{"id":"altar.lancefield-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancefield-farm.folk1"}},{"id":"altar.lancefield-farm.folk2","type":"actor/person/child","name":{"en":"Jerome Marbleford","zh":"哲罗姆·石渡"},"place":{"on":"tile","map":"altar.lancefield-farm.farmhouse-1","x":2,"y":2},"facing":"down","props":{"age":15,"household":"altar.lancefield-farm.h0","purse":1,"favourite":"item/food/fish/cooked"},"tags":["minor"],"contents":["altar.lancefield-farm.folk2.coin0"],"look":{"body":"man","parts":{"hair":"hair.ponytail","face":"face.keen","outfit":"outfit.workshirt","shoes":"shoes.tall"},"colors":{"skin":"light","hair":"black","eyes":"amber","outfit.1":"ochre","outfit.2":"umber","shoes.1":"darkleather"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"altar.lancefield-farm.farmhouse-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"altar.lancefield-farm","x":8,"y":13,"activity":"play"},{"from":12,"to":13,"map":"altar.lancefield-farm.farmhouse-1","x":4,"y":5,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"altar.lancefield-farm","x":8,"y":13,"activity":"play"},{"from":18,"to":20,"map":"altar.lancefield-farm.farmhouse-1","x":4,"y":5,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"The snow on the heights is late melting this year. The sheep still can't get up to the high pasture, so they're on hay.","zh":"山上的雪今年化得晚，羊到现在还上不了高处的草场，只能喂干草。"}}]}}},{"id":"altar.lancefield-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"altar.lancefield-farm.folk2"}}]}