":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Drill before dawn, and after drill we dig ditches. The blisters on my hands never get the chance to heal.","zh":"天不亮就操练，练完了还得去挖壕沟。我这手上的泡就没消过。"}},{"key":"default","text":{"en":"The wolves have been bold this year. They took three of our sheep last month, and we've raised the fence again.","zh":"今年的狼胆子大，上个月叼走了我们三只羊。篱笆我们又加高了一截。"}}]}}},{"id":"redmarch.emberwick-keep.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"redmarch.emberwick-keep.folk1"}},{"id":"redmarch.emberwick-keep.folk2","type":"actor/person/soldier","name":{"en":"Dietmar Redfield","zh":"迪特马尔·赤田"},"place":{"on":"tile","map":"redmarch.emberwick-keep","x":16,"y":8},"facing":"down","props":{"age":52,"household":"redmarch.emberwick-keep.h0","purse":3,"favourite":"item/misc/lute","fights":true},"contents":["redmarch.emberwick-keep.folk2.coin0","redmarch.emberwick-keep.folk2.coin1","redmarch.emberwick-keep.folk2.coin2"],"look":{"body":"man","parts":{"hair":"hair.short","face":"face.weary","hat":"hat.helm","outfit":"outfit.plate","shoes":"shoes.shoes"},"colors":{"skin":"porcelain","hair":"black","eyes":"hazel","hat.1