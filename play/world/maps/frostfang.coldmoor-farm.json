.folk0","type":"actor/person/farmer","name":{"en":"Eirik Pinehill","zh":"埃里克·松丘"},"place":{"on":"tile","map":"frostfang.coldmoor-farm","x":28,"y":3},"facing":"down","props":{"age":38,"household":"frostfang.coldmoor-farm.h0","purse":4,"favourite":"item/material/feather"},"contents":["frostfang.coldmoor-farm.folk0.coin0","frostfang.coldmoor-farm.folk0.coin1","frostfang.coldmoor-farm.folk0.coin2","frostfang.coldmoor-farm.folk0.coin3"],"look":{"body":"man","parts":{"hair":"hair.ponytail","face":"face.bright","outfit":"outfit.workshirt","shoes":"shoes.shoes"},"colors":{"skin":"porcelain","hair":"copper","eyes":"amber","outfit.1":"woad","outfit.2":"slate","shoes.1":"black"}},"npc":{"role":"farmer","schedule":[{"from":22,"to":6,"map":"frostfang.coldmoor-farm.farmhouse-1","x":5,"y":2,"activity":"sleep"},{"from":6,"to":12,"map":"frostfang.coldmoor-farm","x":28,"y":3,"activity":"work"},{"from":12,"to":13,"map":"frostfang.coldmoor-farm.farmhouse-1","x":6,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldmoor-farm","x":28,"y":3,"activity":"work"},{"from":18,"to":22,"map":"frostfang.coldmoor-farm.farmhouse-1","x":6,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Oh, hello. Can I help you?","zh":"啊，你好。找我有事吗？"}},{"key":"hour:morning","text":{"en":"I want these rows hoed by noon. This afternoon I'm helping next door mend their pigsty. I promised.","zh":"我得趁上午把这几垄锄完。下午要去帮邻居家修猪圈，早就说好了的。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"weather:storm","text":{"en":"Storm off the sea. Stack the wood high and keep the shutters shut.","zh":"海上起风暴了。柴堆高，窗板关好。"}}]}}},{"id":"frostfang.coldmoor-farm.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk0"}},{"id":"frostfang.coldmoor-farm.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk0"}},{"id":"frostfang.coldmoor-farm.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk0"}},{"id":"frostfang.coldmoor-farm.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk0"}},{"id":"frostfang.coldmoor-farm.folk1","type":"actor/person/farmer","name":{"en":"Knut Pinehill","zh":"克努特·松丘"},"place":{"on":"tile","map":"frostfang.coldmoor-farm.farmhouse-1","x":2,"y":1},"facing":"down","props":{"age":38,"household":"frostfang.coldmoor-farm.h0","purse":6,"favourite":"item/food/chicken/cooked"},"contents":["frostfang.coldmoor-farm.folk1.coin0","frostfang.coldmoor-farm.folk1.coin1","frostfang.coldmoor-farm.folk1.coin2","frostfang.coldmoor-farm.folk1.coin3","frostfang.coldmoor-farm.folk1.coin4","frostfang.coldmoor-farm.folk1.coin5"],"look":{"body":"man","parts":{"hair":"hair.cropped","face":"face.bright","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"chestnut","eyes":"amber","outfit.1":"undyed","outfit.2":"umber","shoes.1":"leather"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":7,"map":"frostfang.coldmoor-farm.farmhouse-1","x":2,"y":1,"activity":"sleep"},{"from":7,"to":12,"map":"frostfang.coldmoor-farm","x":27,"y":10,"activity":"work"},{"from":12,"to":13,"map":"frostfang.coldmoor-farm.farmhouse-1","x":4,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldmoor-farm","x":27,"y":10,"activity":"work"},{"from":18,"to":21,"map":"frostfang.coldmoor-farm.farmhouse-1","x":4,"y":3,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"weather:rain","text":{"en":"Rain. Good. Walk round, would you, and don't step in the furrows I just opened.","zh":"下雨了，好。你绕着点走，别踩我刚开的沟。"}},{"key":"default","text":{"en":"They say there's a knight on the road past Vesper Ford who stops everyone. Nobody gets by him.","zh":"听说过了晚祷渡的那条大路上，有个骑士把路拦住了，谁也过不去。"}}]}}},{"id":"frostfang.coldmoor-farm.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk1.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk1.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk1.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk1.coin4","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk1.coin5","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk1"}},{"id":"frostfang.coldmoor-farm.folk2","type":"actor/person/farmer","name":{"en":"Hakon Pinehill","zh":"哈康·松丘"},"place":{"on":"tile","map":"frostfang.coldmoor-farm","x":21,"y":5},"facing":"down","props":{"age":42,"household":"frostfang.coldmoor-farm.h0","purse":2,"favourite":"item/material/herb"},"contents":["frostfang.coldmoor-farm.folk2.coin0","frostfang.coldmoor-farm.folk2.coin1"],"look":{"body":"man","parts":{"hair":"hair.tied","face":"face.keen","beard":"beard.moustache","hat":"hat.straw","outfit":"outfit.workshirt","shoes":"shoes.boots"},"colors":{"skin":"light","hair":"copper","eyes":"hazel","hat.1":"ochre","outfit.1":"linen","outfit.2":"slate","shoes.1":"darkleather"}},"npc":{"role":"farmer","schedule":[{"from":21,"to":5,"map":"frostfang.coldmoor-farm.farmhouse-1","x":4,"y":2,"activity":"sleep"},{"from":5,"to":12,"map":"frostfang.coldmoor-farm","x":21,"y":5,"activity":"work"},{"from":12,"to":13,"map":"frostfang.coldmoor-farm.farmhouse-1","x":3,"y":3,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"frostfang.coldmoor-farm","x":21,"y":5,"activity":"work"},{"from":18,"to":21,"map":"frostfang.coldmoor-farm","x":7,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"The wheat came into ear nearly half a month late this year, and the ears are thin. My father farmed forty years and says he never saw the like.","zh":"今年的麦子抽穗晚了快半个月，穗子也瘪。我爹种了四十年地，说从没见过这样的。"}},{"key":"default","text":{"en":"I've turned the east rows twice this week and the soil is still hard. Other years it would be loose by now.","zh":"东边那几垄我这礼拜翻了两遍，土还是硬邦邦的。往年这时候早就松了。"}},{"key":"default","text":{"en":"They say there's a knight on the road past Vesper Ford who stops everyone. Nobody gets by him.","zh":"听说过了晚祷渡的那条大路上，有个骑士把路拦住了，谁也过不去。"}}]}}},{"id":"frostfang.coldmoor-farm.folk2.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk2"}},{"id":"frostfang.coldmoor-farm.folk2.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"frostfang.coldmoor-farm.folk2"}}]}