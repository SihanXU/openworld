"contents":["holy.myrrhwood.folk0.coin0","holy.myrrhwood.folk0.coin1","holy.myrrhwood.folk0.coin2","holy.myrrhwood.folk0.coin3"],"look":{"body":"man","parts":{"hair":"hair.swept","face":"face.bright","hat":"hat.cap","outfit":"outfit.workshirt","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"umber","eyes":"bark","hat.1":"slate","outfit.1":"linen","outfit.2":"moss","shoes.1":"darkleather"}},"npc":{"role":"villager","schedule":[{"from":21,"to":5,"map":"holy.myrrhwood.home-1","x":1,"y":1,"activity":"sleep"},{"from":5,"to":12,"map":"holy.myrrhwood.home-1","x":9,"y":2,"activity":"work"},{"from":12,"to":13,"map":"holy.myrrhwood.home-1","x":3,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.myrrhwood.home-1","x":9,"y":2,"activity":"work"},{"from":18,"to":21,"map":"holy.myrrhwood","x":21,"y":17,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello. I haven't seen you before. Are you from out of town?","zh":"你好。没见过你，是外地来的吧？"}},{"key":"hour:morning","text":{"en":"Up already? The bakery isn't open yet. I want the first batch; flour is short, and by mid-morning there's nothing left.","zh":"这么早就起了？面包房还没开门呢。我得赶第一炉，这阵子面粉紧，晚了就买不着了。"}},{"key":"default","text":{"en":"Mind your purse in the crowd by the gate.","zh":"城门边人多，看好你的钱袋。"}}]}}},{"id":"holy.myrrhwood.folk0.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhwood.folk0"}},{"id":"holy.myrrhwood.folk0.coin1","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhwood.folk0"}},{"id":"holy.myrrhwood.folk0.coin2","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhwood.folk0"}},{"id":"holy.myrrhwood.folk0.coin3","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhwood.folk0"}},{"id":"holy.myrrhwood.folk1","type":"actor/person/child","name":{"en":"Tiberius Dawnford","zh":"提比略·曙渡"},"place":{"on":"tile","map":"holy.myrrhwood.home-1","x":2,"y":2},"facing":"down","props":{"age":9,"household":"holy.myrrhwood.h0","purse":1,"favourite":"item/misc/dice"},"tags":["minor"],"contents":["holy.myrrhwood.folk1.coin0"],"look":{"body":"boy","parts":{"hair":"hair.childbob","face":"face.child","outfit":"outfit.smock","legs":"legs.hose","shoes":"shoes.shoes"},"colors":{"skin":"fair","hair":"umber","eyes":"hazel","outfit.1":"ochre","legs.1":"umber","shoes.1":"umber"}},"npc":{"role":"child","schedule":[{"from":20,"to":7,"map":"holy.myrrhwood.home-1","x":2,"y":2,"activity":"sleep"},{"from":7,"to":12,"map":"holy.myrrhwood.home-1","x":8,"y":2,"activity":"play"},{"from":12,"to":13,"map":"holy.myrrhwood.home-1","x":4,"y":4,"activity":"eat","tends":["hungry"]},{"from":13,"to":18,"map":"holy.myrrhwood.home-1","x":8,"y":2,"activity":"play"},{"from":18,"to":20,"map":"holy.myrrhwood.home-1","x":4,"y":4,"activity":"rest"}],"fidelity":"local","person":{"lines":[{"key":"greeting:first","text":{"en":"Hello there. Where are you from? So many people have been passing through lately.","zh":"你好啊，从哪儿来的？这阵子过路的人真多。"}},{"key":"default","text":{"en":"Can you hop to the well and back on one foot? I can. I did twenty hops without switching.","zh":"你能单脚跳到井边再跳回来吗？我能，我跳了二十下都没换脚。"}},{"key":"default","text":{"en":"My mum says I can't go out after dark because something out there takes children. Have you ever seen one?","zh":"我娘说天黑了不许出门，外面有东西会把小孩叼走。你见过那种东西吗？"}},{"key":"default","text":{"en":"Pilgrims come into the city every day now. The inns have been full for weeks, and plenty of them sleep out on the squares.","zh":"这阵子天天有朝圣的人进城，客栈早就住满了，好多人只能在广场上过夜。"}}]}}},{"id":"holy.myrrhwood.folk1.coin0","type":"item/misc/thornmark","place":{"on":"inside","holder":"holy.myrrhwood.folk1"}},{"id":"holy.myrrhwood.folk2","type":"actor/person/villager","name":{"en":"Dorothea Lambwood","zh":"多萝西娅·羔林"},"place":{"on":"tile","map":"holy.myrrhwood","x":17,"y":19},"facing":"down","props":{"age":29,"household":"holy.myrrhwood.h1","purse":6,"favourite":"item/food/fish/cooked"},"contents":["holy.myrrhwood.folk