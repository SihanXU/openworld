// Generated by the upstream loop (tools/src/upstream.ts): the promotion test. For each learned rule
// the proposal subsumes, the scene that asked for it must now resolve to a BASE rule (no hole left
// for the learned layer), and what the learned rule did there must still happen. This file is
// written by the judge after submission; the agent never edits it.

import { describe, expect, it } from 'vitest'
import { RuleLibrary, checkExpectations, replay, type Expectation, type Scenario } from '@lsw/engine'
import { BASE_RULES, STORY_RULES, buildOntology } from '@lsw/content'

interface Case {
  /** the learned rule, its host type and the hole it filled */
  rule: string
  type: string
  hole: string
  scene: Scenario
  expect: Expectation[]
}

const CASES: Case[] = /*__CASES__*/ []

const onto = buildOntology()
const lib = new RuleLibrary([...BASE_RULES, ...STORY_RULES])

describe('promotion: the base answers what the learned rules answered', () => {
  for (const c of CASES) {
    it(`${c.type} at ${c.hole} (was ${c.rule})`, () => {
      const rp = replay(c.scene, onto, lib)
      expect(rp.errors, 'the scene replays').toEqual([])
      expect(rp.resolution.defined, `still a hole at ${rp.resolution.hole?.rule.id ?? '?'}: no base rule answers this scene`).toBe(true)
      expect(rp.resolution.rule?.source?.origin ?? 'base', 'answered by a learned rule, not the base').toBe('base')
      expect(checkExpectations(rp.engine, c.expect, rp.resolution), 'the learned rule\'s outcome no longer holds').toEqual([])
    })
  }
})
