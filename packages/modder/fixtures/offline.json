            "x": 2,
            "y": 1
           }
          ],
          "event": {
           "kind": "impulse/offered",
           "host": "w",
           "actor": "actor",
           "item": "r",
           "source": "r"
          }
         },
         "expect": [
          {
           "key": "w",
           "hasStatus": "frozen"
          }
         ]
        }
       ]
      }
     },
