          {
           "op": "emit",
           "impulse": "offered",
           "to": "target",
           "item": "host"
          }
         ]
        }
       },
       "tests": [
        {
         "name": "a rope used on another green slime binds it",
         "given": {
          "entities": [
           {
            "key": "actor",
            "type": "actor/person/player",
            "x": 2,
            "y": 2
           },
           {
            "key": "r",
            "type": "item/tool/rope",
            "x": 2,
            "y": 2,
            "heldBy": "actor"
           },
           {
            "key": "w",
            "type": "actor/creature/slime/green_slime",
