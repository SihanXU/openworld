[
 {
  "purpose": "design",
  "contains": "core/offered",
  "reply": {
   "patch": {
    "note": "a stone weighs down the green slime it is held out to",
    "artifacts": [
     {
      "kind": "rule",
      "rule": {
       "id": "patch/stone-weighs-creature",
       "host": {
        "type": "actor/creature/slime/green_slime"
       },
       "on": "impulse/offered",
       "doc": "A green slime offered a stone (anything stony) is weighed down by it for a while and takes it in; anything else stays open.",
       "tree": {
        "if": {
         "is": {
          "role": "item",
          "sel": {
           "tags": [
            "stone"
           ]
          }
         }
        },
        "then": {
         "do": [
          {
           "op": "addStatus",
           "status": "frozen",
           "duration": 40
          },
          {
           "op": "emit",
           "impulse": "taken",
           "to": "item",
           "params": {
            "into": "contents"
           },
           "other": "host"
          },
          {
           "op": "vfx",
           "fx": "dust"
          },
          {
           "op": "log",
           "text": {
            "en": "You weigh {host} down with {item}.",
            "zh": "你用{item}把{host}压住了。"
           }
          }
         ]
        },
        "else": {
         "undefined": true
        }
       },
       "tests": [
        {
         "name": "a stone held out to another green slime weighs it down too",
         "given": {
          "entities": [
           {
            "key": "actor",
            "type": "actor/person/player",
            "x": 2,
            "y": 2
           },
           {
            "key": "r",
            "type": "item/material/stone",
            "x": 2,
            "y": 2,
            "heldBy": "actor"
           },
           {
            "key": "w",
            "type": "actor/creature/slime/green_slime",
            "x": 2,
            "y": 1
           }
          ],
          "event": {
           "kind": "impulse/offered",
           "host": "w",
           "actor": "actor",
           "item": "r",
           "source": "r"
          }
         },
         "expect": [
          {
           "key": "w",
           "hasStatus": "frozen"
          }
         ]
        }
       ]
      }
     }
    ]
   },
   "summary": "stony things weigh down the creature they are held out to"
  }
 },
 {
