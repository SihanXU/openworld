            "zh": "你用{item}把{host}捆了个结实。"
           }
          }
         ]
        }
       },
       "tests": [
        {
         "name": "a rope put on another green slime binds it too",
         "given": {
          "entities": [
           {
            "key": "actor",
            "type": "actor/person/player",
            "x": 2,
            "y": 2
           },
           {
            "key": "r",
