{
  "name": "openworld-editor-desktop",
  "productName": "OpenWorld Editor",
  "version": "0.1.0",
  "description": "The OpenWorld Editor as a desktop application: make games on the OpenWorld engine.",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "dev.openworld.editor",
    "productName": "OpenWorld Editor",
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "editor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development",
      "artifactName": "OpenWorld-Editor-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "OpenWorld-Editor-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "OpenWorld-Editor-${version}-${arch}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SihanXU/symbolic-world.git"
  },
  "desktopName": "openworld-editor.desktop"
}
